{%- doc -%}
  Renders an editorial promo card inside a mega menu dropdown.
{%- enddoc -%}

{% render 'mega-menu-promo-card', block: block %}

{% schema %}
{
  "name": "Mega Menu Promo Card",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "menu_item",
      "label": "Target menu item",
      "info": "Dropdown title e.g. Skin Care, Hair Care, Fragrances, Makeup, Brands",
      "default": "Hair Care"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Promo image",
      "info": "Upload custom image or use fallback asset."
    },
    {
      "type": "text",
      "id": "image_asset",
      "label": "Fallback image asset",
      "info": "Asset filename e.g. cat-haircare.jpg, cat-shampoo.jpg, cat-skincare.jpg, cat-fragrance.jpg"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge text",
      "default": "Hair Wellness"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Headline",
      "default": "Salon-Quality Hair Rituals"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Restorative masks, treatment oils, and everyday styling."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Card link"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text",
      "default": "Shop Hair Care"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Badge text color",
      "default": "#BD7385"
    }
  ],
  "presets": [
    {
      "name": "Mega Menu Promo Card"
    }
  ]
}
{% endschema %}
