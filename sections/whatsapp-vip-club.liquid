{% doc %}
  Customer Care & VIP Club Section for Kay Cosmetics.
  Refined luxury beauty styling with an integrated pill form,
  balanced proportions, member perks, and optional WhatsApp concierge.
  Fully configurable through Shopify Theme Editor settings.
{% enddoc %}

{% liquid
  assign section_id = section.id | replace: '-', '_'
  assign card_max_width = section.settings.card_max_width | default: 'page_width'
  assign layout_align = section.settings.layout_alignment | default: 'center'
  assign card_bg_style = section.settings.card_bg_style | default: 'luxury_gradient'
  assign card_radius = section.settings.card_border_radius | default: 20
  assign card_padding = section.settings.card_padding | default: 48
  assign card_border_color = section.settings.card_border_color | default: '#EBE1F2'
  
  assign eyebrow = section.settings.eyebrow
  assign eyebrow_color = section.settings.eyebrow_color | default: '#BD7385'
  assign eyebrow_size = section.settings.eyebrow_size | default: 11
  assign eyebrow_style = section.settings.eyebrow_style | default: 'uppercase'
  
  assign heading = section.settings.title
  assign heading_tag = section.settings.heading_tag | default: 'h2'
  assign heading_size = section.settings.heading_size | default: 'medium'
  assign heading_size_desktop = section.settings.heading_size_desktop | default: 32
  assign heading_color = section.settings.heading_color | default: '#2C1E26'
  
  assign subtitle = section.settings.subtitle
  assign subtitle_color = section.settings.subtitle_color | default: '#574A52'
  assign subtitle_size = section.settings.subtitle_size | default: 14.5
  
  assign form_design = section.settings.form_design | default: 'integrated_capsule'
  assign input_placeholder = section.settings.input_placeholder | default: 'Enter your email address...'
  assign input_bg = section.settings.input_bg_color | default: '#FFFFFF'
  assign input_text = section.settings.input_text_color | default: '#2C1E26'
  assign input_border = section.settings.input_border_color | default: '#E2D7EC'
  
  assign btn_label = section.settings.button_label | default: 'Subscribe'
  assign btn_style = section.settings.button_style | default: 'primary_rosewood'
  assign btn_bg = section.settings.button_bg_color | default: '#BD7385'
  assign btn_text = section.settings.button_text_color | default: '#FFFFFF'
  assign btn_radius = section.settings.button_border_radius | default: 8
  
  assign show_perks = section.settings.show_perks
  assign perk_1 = section.settings.perk_1_text | default: '100% Authentic Brands'
  assign perk_2 = section.settings.perk_2_text | default: 'Direct Wholesale Pricing'
  assign perk_3 = section.settings.perk_3_text | default: 'Nationwide Delivery'
  assign privacy_note = section.settings.privacy_note | default: 'No spam. Unsubscribe at any time.'
  
  assign show_wa = section.settings.show_whatsapp
  assign wa_num = section.settings.whatsapp_number
  
  assign show_top_div = section.settings.show_top_divider
  assign show_bottom_div = section.settings.show_bottom_divider
  assign sec_div_color = section.settings.section_divider_color | default: '#EFE6E8'
%}

<div
  id="WhatsappVip-{{ section.id }}"
  class="section section--{{ section.settings.section_width }} whatsapp-vip-section spacing-style {% if show_top_div %}whatsapp-vip--top-divider{% endif %} {% if show_bottom_div %}whatsapp-vip--bottom-divider{% endif %}"
  style="
    {% render 'spacing-style', settings: section.settings %}
    --wcard-radius: {{ card_radius }}px;
    --wcard-padding: {{ card_padding }}px;
    --wcard-border-color: {{ card_border_color }};
    --winput-bg: {{ input_bg }};
    --winput-text: {{ input_text }};
    --winput-border: {{ input_border }};
    --wbtn-radius: {{ btn_radius }}px;
    --wsec-divider: {{ sec_div_color }};
  "
>
  {%- style -%}
    #WhatsappVip-{{ section.id }} {
      position: relative;
    }

    #WhatsappVip-{{ section.id }}.whatsapp-vip--top-divider {
      border-top: 1px solid var(--wsec-divider, #EFE6E8);
    }

    #WhatsappVip-{{ section.id }}.whatsapp-vip--bottom-divider {
      border-bottom: 1px solid var(--wsec-divider, #EFE6E8);
    }

    /* Outer Container Wrap to control max-width & eliminate empty void */
    #WhatsappVip-{{ section.id }} .whatsapp-vip-container {
      width: 100%;
      margin: 0 auto;
      {% case card_max_width %}
        {% when 'compact' %}
          max-width: 940px;
        {% when 'medium' %}
          max-width: 1080px;
        {% when 'wide' %}
          max-width: 1220px;
        {% else %}
          max-width: 100%;
      {% endcase %}
    }

    /* Refined Luxury Card Frame */
    #WhatsappVip-{{ section.id }} .whatsapp-card-frame {
      position: relative;
      overflow: hidden;
      width: 100%;
      padding: clamp(32px, 4.5vw, var(--wcard-padding, 48px)) clamp(20px, 4vw, 48px);
      border: 1px solid var(--wcard-border-color, #EBE1F2);
      border-radius: var(--wcard-radius, 20px);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9),
                  0 14px 36px -12px rgba(44, 30, 38, 0.05),
                  0 2px 6px rgba(44, 30, 38, 0.02);
      transition: box-shadow 0.35s ease, border-color 0.35s ease;

      {% case card_bg_style %}
        {% when 'luxury_gradient' %}
          background: linear-gradient(180deg, #FDF8FD 0%, #F5ECF8 100%);
        {% when 'soft_blush' %}
          background: linear-gradient(180deg, #FDF9FA 0%, #FAF2F5 100%);
        {% when 'pastel_lilac' %}
          background: #F6EDFA;
        {% when 'canvas' %}
          background: var(--yozo-canvas, #FAF5F2);
        {% when 'white' %}
          background: #FFFFFF;
        {% when 'custom' %}
          background: {{ section.settings.card_bg_color | default: '#F6EDFA' }};
        {% else %}
          background: linear-gradient(180deg, #FDF8FD 0%, #F5ECF8 100%);
      {% endcase %}

      {% if layout_align == 'center' %}
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 20px;
      {% else %}
        display: grid;
        grid-template-columns: 1.15fr 1fr;
        gap: clamp(28px, 4vw, 48px);
        align-items: center;
      {% endif %}
    }

    @media (max-width: 860px) {
      #WhatsappVip-{{ section.id }} .whatsapp-card-frame {
        padding: clamp(32px, 6vw, 44px) 20px !important;
        {% if layout_align == 'center' %}
          display: flex !important;
          flex-direction: column !important;
          align-items: center !important;
          text-align: center !important;
          gap: 20px !important;
        {% else %}
          display: flex !important;
          flex-direction: column !important;
          align-items: flex-start !important;
          text-align: left !important;
          gap: 24px !important;
        {% endif %}
      }
        display: flex !important;
        flex-direction: column !important;
        align-items: flex-start !important;
        text-align: left !important;
        gap: 24px !important;
        padding: clamp(22px, 5vw, 32px) !important;
      }

      #WhatsappVip-{{ section.id }} .whatsapp-actions-box {
        max-width: 100% !important;
        justify-self: stretch !important;
      }
    }

    /* Info Column */
    #WhatsappVip-{{ section.id }} .whatsapp-vip-info {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      {% if layout_align == 'center' %}
        align-items: center;
        max-width: 640px;
      {% else %}
        align-items: flex-start;
      {% endif %}
    }

    #WhatsappVip-{{ section.id }} .section-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: {{ eyebrow_size }}px;
      font-weight: 600;
      letter-spacing: {% if eyebrow_style == 'uppercase' %}0.14em{% else %}normal{% endif %};
      text-transform: {% if eyebrow_style == 'uppercase' %}uppercase{% else %}none{% endif %};
      color: {{ eyebrow_color }};
      margin-bottom: 10px;
      {% if layout_align == 'center' %}
        justify-content: center;
      {% endif %}
    }

    #WhatsappVip-{{ section.id }} .section-eyebrow::before {
      content: '';
      display: inline-block;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background-color: {{ eyebrow_color }};
      opacity: 0.8;
    }

    #WhatsappVip-{{ section.id }} .section-title {
      font-family: var(--font-heading--family), serif;
      color: {{ heading_color }};
      letter-spacing: -0.02em;
      line-height: 1.24;
      margin: 0 0 12px 0;
      {% if layout_align == 'center' %}
        text-align: center;
      {% endif %}
      {% case heading_size %}
        {% when 'small' %}
          font-size: clamp(1.4rem, 2.5vw, 1.75rem);
        {% when 'large' %}
          font-size: clamp(1.9rem, 3.6vw, 2.45rem);
        {% when 'custom' %}
          font-size: clamp(1.5rem, 2.8vw, {{ heading_size_desktop }}px);
        {% else %}
          font-size: clamp(1.6rem, 3vw, 2.25rem);
      {% endcase %}
    }

    #WhatsappVip-{{ section.id }} .section-subtitle {
      font-size: {{ subtitle_size }}px;
      color: {{ subtitle_color }};
      line-height: 1.6;
      margin: 0;
      letter-spacing: -0.01em;
      {% if layout_align == 'center' %}
        max-width: 580px;
        margin-left: auto;
        margin-right: auto;
        text-align: center;
      {% else %}
        max-width: 480px;
      {% endif %}
    }

    /* Actions Box */
    #WhatsappVip-{{ section.id }} .whatsapp-actions-box {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      gap: 12px;
      width: 100%;
      {% if layout_align == 'center' %}
        max-width: 480px;
        margin: 0 auto;
        align-items: center;
      {% else %}
        max-width: 500px;
        justify-self: end;
      {% endif %}
    }

    #WhatsappVip-{{ section.id }} .vip-form {
      width: 100%;
      margin: 0;
    }

    /* Integrated Capsule Form (Single Sculpted White Pill) */
    #WhatsappVip-{{ section.id }} .vip-form-capsule {
      display: flex;
      align-items: center;
      background: var(--winput-bg, #FFFFFF);
      border: 1px solid var(--winput-border, #E2D7EC);
      border-radius: 999px;
      padding: 5px 6px 5px 18px;
      box-shadow: 0 4px 20px rgba(44, 30, 38, 0.05);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      width: 100%;
      max-width: 480px;
      margin: 0 auto;
    }

    #WhatsappVip-{{ section.id }} .vip-form-capsule:focus-within {
      border-color: var(--yozo-rosewood, #BD7385);
      background: #FFFFFF;
      box-shadow: 0 0 0 3px rgba(189, 115, 133, 0.16),
                  0 8px 24px rgba(44, 30, 38, 0.06);
    }

    #WhatsappVip-{{ section.id }} .vip-capsule-icon {
      color: #A3969E;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-right: 10px;
      flex-shrink: 0;
      transition: color 0.25s ease;
    }

    #WhatsappVip-{{ section.id }} .vip-form-capsule:focus-within .vip-capsule-icon {
      color: var(--yozo-rosewood, #BD7385);
    }

    #WhatsappVip-{{ section.id }} .vip-capsule-input {
      flex: 1;
      min-width: 0;
      border: none !important;
      outline: none !important;
      background: transparent !important;
      padding: 10px 0;
      font-size: 0.9375rem;
      color: var(--winput-text, #2C1E26);
      letter-spacing: -0.01em;
      box-shadow: none !important;
    }

    #WhatsappVip-{{ section.id }} .vip-capsule-input::placeholder {
      color: #9D8E97;
      opacity: 0.85;
    }

    #WhatsappVip-{{ section.id }} .vip-capsule-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 11px 22px;
      border-radius: 999px;
      font-size: 0.875rem;
      font-weight: 500;
      letter-spacing: 0.01em;
      cursor: pointer;
      text-decoration: none;
      border: none;
      outline: none;
      flex-shrink: 0;
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      {% case btn_style %}
        {% when 'primary_rosewood' %}
          background-color: var(--yozo-rosewood, #BD7385);
          color: #FFFFFF;
        {% when 'solid_plum' %}
          background-color: var(--yozo-plum-dark, #2C1E26);
          color: #FFFFFF;
        {% when 'custom' %}
          background-color: {{ btn_bg | default: '#BD7385' }};
          color: {{ btn_text | default: '#FFFFFF' }};
        {% else %}
          background-color: var(--yozo-rosewood, #BD7385);
          color: #FFFFFF;
      {% endcase %}
    }

    #WhatsappVip-{{ section.id }} .vip-capsule-btn:hover {
      {% case btn_style %}
        {% when 'primary_rosewood' %}
          background-color: var(--yozo-rosewood-hover, #A75D6F);
          transform: translateY(-1px);
          box-shadow: 0 4px 14px rgba(189, 115, 133, 0.32);
        {% when 'solid_plum' %}
          background-color: #422D3A;
          transform: translateY(-1px);
          box-shadow: 0 4px 14px rgba(44, 30, 38, 0.25);
        {% when 'custom' %}
          opacity: 0.92;
          transform: translateY(-1px);
        {% else %}
          background-color: var(--yozo-rosewood-hover, #A75D6F);
          transform: translateY(-1px);
      {% endcase %}
    }

    #WhatsappVip-{{ section.id }} .vip-capsule-btn-arrow {
      display: inline-block;
      transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }

    #WhatsappVip-{{ section.id }} .vip-capsule-btn:hover .vip-capsule-btn-arrow {
      transform: translateX(3px);
    }

    /* Fallback Split Form */
    #WhatsappVip-{{ section.id }} .vip-split-form {
      display: flex;
      gap: 8px;
      width: 100%;
    }

    #WhatsappVip-{{ section.id }} .vip-split-input {
      flex: 1;
      min-height: 46px;
      padding: 12px 18px;
      border: 1px solid var(--winput-border, #E2D7EC);
      border-radius: var(--wbtn-radius, 8px);
      font-size: 0.875rem;
      background: var(--winput-bg, #FFFFFF);
      color: var(--winput-text, #2C1E26);
      outline: none;
    }

    #WhatsappVip-{{ section.id }} .vip-split-btn {
      min-height: 46px;
      padding: 12px 24px;
      border-radius: var(--wbtn-radius, 8px);
      font-size: 0.875rem;
      font-weight: 500;
      background: var(--yozo-rosewood, #BD7385);
      color: #FFFFFF;
      border: 1px solid var(--yozo-rosewood, #BD7385);
      cursor: pointer;
    }

    @media (max-width: 520px) {
      #WhatsappVip-{{ section.id }} .vip-form-capsule {
        border-radius: 12px;
        flex-direction: column;
        padding: 10px;
        gap: 8px;
        align-items: stretch;
      }
      #WhatsappVip-{{ section.id }} .vip-capsule-input {
        padding: 6px 8px;
      }
      #WhatsappVip-{{ section.id }} .vip-capsule-btn {
        width: 100%;
        border-radius: 8px;
      }
      #WhatsappVip-{{ section.id }} .vip-capsule-icon {
        display: none;
      }
    }

    /* Reassurance & Value Micro-Perks Row */
    #WhatsappVip-{{ section.id }} .vip-perks-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 14px 18px;
      margin-top: 10px;
      {% if layout_align == 'center' %}
        justify-content: center;
      {% endif %}
    }

    #WhatsappVip-{{ section.id }} .vip-perk-item {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 0.75rem;
      font-weight: 500;
      color: #6B5C65;
      letter-spacing: -0.005em;
    }

    #WhatsappVip-{{ section.id }} .vip-perk-icon {
      color: var(--yozo-rosewood, #BD7385);
      font-size: 0.8125rem;
      line-height: 1;
    }

    #WhatsappVip-{{ section.id }} .vip-privacy-note {
      font-size: 0.6875rem;
      color: #94848D;
      margin-top: 4px;
      letter-spacing: 0.01em;
      {% if layout_align == 'center' %}
        text-align: center;
      {% endif %}
    }

    /* Optional WhatsApp Direct Pill */
    #WhatsappVip-{{ section.id }} .whatsapp-direct-pill {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 10px 18px;
      border-radius: 999px;
      font-size: 0.8125rem;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.25s ease;
      cursor: pointer;
      width: fit-content;
      margin-bottom: 6px;
      {% if section.settings.whatsapp_btn_style == 'primary_green' %}
        background-color: #25D366;
        color: #FFFFFF;
        border: 1px solid #25D366;
      {% elsif section.settings.whatsapp_btn_style == 'primary_rosewood' %}
        background-color: var(--yozo-rosewood, #BD7385);
        color: #FFFFFF;
        border: 1px solid var(--yozo-rosewood, #BD7385);
      {% else %}
        background-color: #FFFFFF;
        color: var(--yozo-plum-dark, #2C1E26);
        border: 1px solid #E2D7EC;
      {% endif %}
    }

    #WhatsappVip-{{ section.id }} .whatsapp-direct-pill:hover {
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(44, 30, 38, 0.1);
    }

    #WhatsappVip-{{ section.id }} .vip-form-success {
      color: #2A6B3D;
      font-size: 0.8125rem;
      margin: 8px 0 0 0;
      font-weight: 500;
    }

    #WhatsappVip-{{ section.id }} .vip-form-error {
      color: #A33A3A;
      font-size: 0.8125rem;
      margin: 8px 0 0 0;
      font-weight: 500;
    }
  {%- endstyle -%}

  <div class="whatsapp-vip-container">
    <div class="whatsapp-card-frame">
      <div class="whatsapp-vip-info">
        {% if eyebrow != blank %}
          <span class="section-eyebrow">{{ eyebrow }}</span>
        {% endif %}

        {% if heading != blank %}
          <{{ heading_tag }} class="section-title">
            {{ heading }}
          </{{ heading_tag }}>
        {% endif %}

        {% if subtitle != blank %}
          <p class="section-subtitle">{{ subtitle }}</p>
        {% endif %}
      </div>

      <div class="whatsapp-actions-box">
        {% if show_wa and wa_num != blank %}
          {% liquid
            assign clean_number = wa_num | remove: '+' | remove: ' ' | remove: '-'
            assign wa_url = 'https://wa.me/' | append: clean_number | append: '?text=' | append: section.settings.whatsapp_preset_message | url_encode
          %}

          <a
            href="{{ wa_url }}"
            target="_blank"
            rel="noopener noreferrer"
            class="whatsapp-direct-pill"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12.031 2C6.512 2 2.023 6.48 2.023 11.988c0 1.76.46 3.48 1.332 5l-1.417 5.176 5.313-1.393a9.92 9.92 0 0 0 4.78 1.226h.004c5.517 0 10.007-4.48 10.007-9.99A9.95 9.95 0 0 0 12.03 2zm0 18.28a8.28 8.28 0 0 1-4.223-1.154l-.303-.18-3.14.823.839-3.06-.197-.313a8.26 8.26 0 0 1-1.27-4.408c0-4.57 3.72-8.288 8.297-8.288 2.215 0 4.298.863 5.863 2.428a8.24 8.24 0 0 1 2.43 5.86c0 4.57-3.72 8.29-8.296 8.29zm4.545-6.208c-.249-.125-1.472-.726-1.7-.809-.229-.083-.395-.125-.561.125-.166.249-.644.81-.789.976-.145.166-.291.187-.54.062-.25-.125-1.053-.388-2.006-1.238-.742-.662-1.243-1.48-1.389-1.729-.145-.25-.015-.385.11-.51.112-.112.25-.29.374-.436.124-.145.166-.25.25-.415.083-.166.041-.312-.021-.436-.063-.125-.561-1.35-.769-1.85-.202-.486-.407-.42-.56-.428l-.478-.008c-.166 0-.436.062-.664.312-.228.249-.872.852-.872 2.077 0 1.226.893 2.41 1.018 2.576.125.166 1.756 2.68 4.254 3.758.594.257 1.058.41 1.42.525.597.19 1.14.163 1.57.099.479-.072 1.472-.602 1.68-1.184.208-.581.208-1.08.145-1.184-.062-.104-.228-.166-.477-.29z"/>
            </svg>
            <span>{{ section.settings.whatsapp_btn_label }}</span>
          </a>
        {% endif %}

        {% form 'customer', class: 'vip-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">

          {% if form_design == 'integrated_capsule' %}
            <div class="vip-form-capsule">
              <span class="vip-capsule-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                </svg>
              </span>
              <input
                type="email"
                name="contact[email]"
                id="VipEmailInput-{{ section.id }}"
                class="vip-capsule-input"
                value="{{ form.email }}"
                placeholder="{{ input_placeholder }}"
                autocorrect="off"
                autocapitalize="off"
                required
              >
              <button type="submit" class="vip-capsule-btn">
                <span>{{ btn_label }}</span>
                <span class="vip-capsule-btn-arrow" aria-hidden="true">&rarr;</span>
              </button>
            </div>
          {% else %}
            <div class="vip-split-form">
              <input
                type="email"
                name="contact[email]"
                id="VipEmailInput-{{ section.id }}"
                class="vip-split-input"
                value="{{ form.email }}"
                placeholder="{{ input_placeholder }}"
                autocorrect="off"
                autocapitalize="off"
                required
              >
              <button type="submit" class="vip-split-btn">
                {{ btn_label }}
              </button>
            </div>
          {% endif %}

          {% if form.posted_successfully? %}
            <p class="vip-form-success">
              {{ section.settings.success_message | default: 'Thank you for subscribing to Kay Cosmetics.' }}
            </p>
          {% endif %}
          {% if form.errors %}
            <p class="vip-form-error">
              {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
            </p>
          {% endif %}
        {% endform %}

        {% if show_perks %}
          <div class="vip-perks-row">
            {% if perk_1 != blank %}
              <div class="vip-perk-item">
                <span class="vip-perk-icon" aria-hidden="true">&#10003;</span>
                <span>{{ perk_1 }}</span>
              </div>
            {% endif %}
            {% if perk_2 != blank %}
              <div class="vip-perk-item">
                <span class="vip-perk-icon" aria-hidden="true">&#10003;</span>
                <span>{{ perk_2 }}</span>
              </div>
            {% endif %}
            {% if perk_3 != blank %}
              <div class="vip-perk-item">
                <span class="vip-perk-icon" aria-hidden="true">&#10003;</span>
                <span>{{ perk_3 }}</span>
              </div>
            {% endif %}
          </div>
        {% endif %}

        {% if privacy_note != blank %}
          <div class="vip-privacy-note">{{ privacy_note }}</div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

