{% doc %}
  Category Grid & Slider section for Kay Cosmetics.
  Supports playful Flower Badge Carousel, standard cards, and merchant styling.
{% enddoc %}

<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer="defer"></script>

{% liquid
  assign section_id = section.id | replace: '-', '_'
  assign bg_color = section.settings.section_bg_color
  assign header_align = section.settings.header_alignment | default: 'left'
  assign display_format = section.settings.display_format | default: 'slider'
  assign card_style = section.settings.card_style | default: 'scallop_flower'
  assign badge_size = section.settings.badge_size | default: 145
  assign items_desktop = section.settings.items_desktop | default: '6.5'
  assign items_tablet = section.settings.items_tablet | default: '4.5'
  assign items_mobile = section.settings.items_mobile | default: '2.3'
  assign show_arrows = section.settings.show_arrows
  assign enable_autoplay = section.settings.enable_autoplay
  assign autoplay_speed = section.settings.autoplay_speed | default: 5
  assign scallop_color_type = section.settings.scallop_color_type | default: 'vibrant_pink'
  assign scallop_custom_color = section.settings.scallop_custom_color | default: '#FF5DA2'
  assign show_view_all = section.settings.show_view_all
  assign view_all_pos = section.settings.view_all_position | default: 'header'
  assign view_all_style = section.settings.view_all_style | default: 'button_outline'
  assign view_all_label = section.settings.view_all_label | default: 'View All Collections'
  assign view_all_link = section.settings.view_all_link | default: '/collections'
%}

<div
  id="CategoryGrid-{{ section.id }}"
  class="section section--{{ section.settings.section_width }} category-grid-section spacing-style"
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% if bg_color != blank and bg_color != 'rgba(0,0,0,0)' %}background-color: {{ bg_color }};{% endif %}
    --cat-cols-desktop: {{ items_desktop | floor | at_least: 2 }};
    --cat-cols-tablet: {{ items_tablet | floor | at_least: 2 }};
    --cat-cols-mobile: {{ items_mobile | floor | at_least: 1 }};
    --cat-badge-size: {{ badge_size }}px;
  "
>
  {%- capture view_all_element -%}
    {% if show_view_all and view_all_link != blank %}
      {% if view_all_style == 'link_arrow' %}
        <a href="{{ view_all_link }}" class="category-grid__view-all-link">
          <span>{{ view_all_label }}</span>
          <span class="category-grid__view-all-arrow" aria-hidden="true">&rarr;</span>
        </a>
      {% elsif view_all_style == 'button_outline' %}
        <a href="{{ view_all_link }}" class="category-grid__btn category-grid__btn--outline">
          <span>{{ view_all_label }}</span>
          <span class="category-grid__btn-arrow" aria-hidden="true">&rarr;</span>
        </a>
      {% elsif view_all_style == 'button_rosewood' %}
        <a href="{{ view_all_link }}" class="category-grid__btn category-grid__btn--rosewood">
          <span>{{ view_all_label }}</span>
          <span class="category-grid__btn-arrow" aria-hidden="true">&rarr;</span>
        </a>
      {% elsif view_all_style == 'button_plum' %}
        <a href="{{ view_all_link }}" class="category-grid__btn category-grid__btn--plum">
          <span>{{ view_all_label }}</span>
          <span class="category-grid__btn-arrow" aria-hidden="true">&rarr;</span>
        </a>
      {% endif %}
    {% endif %}
  {%- endcapture -%}

  <div class="category-grid-header category-grid-header--{{ header_align }} {% if show_view_all and view_all_pos != 'bottom' and header_align != 'center' %}category-grid-header--split{% endif %}">
    <div class="category-grid-header__text">
      {% if section.settings.eyebrow != blank %}
        <span
          class="section-eyebrow section-eyebrow--{{ section.settings.eyebrow_style | default: 'uppercase' }}"
          {% if section.settings.eyebrow_color != blank %}
            style="color: {{ section.settings.eyebrow_color }};"
          {% endif %}
        >
          {{ section.settings.eyebrow }}
        </span>
      {% endif %}

      {% if section.settings.title != blank %}
        <h2
          class="section-title section-title--{{ section.settings.heading_size | default: 'medium' }}"
          {% if section.settings.heading_color != blank %}
            style="color: {{ section.settings.heading_color }};"
          {% endif %}
        >
          {{ section.settings.title }}
        </h2>
      {% endif %}

      {% if section.settings.subtitle != blank %}
        <p
          class="section-subtitle"
          style="
            {% if section.settings.subtitle_color != blank %}color: {{ section.settings.subtitle_color }};{% endif %}
            {% if header_align == 'center' %}margin-left: auto; margin-right: auto;{% elsif header_align == 'right' %}margin-left: auto;{% endif %}
          "
        >
          {{ section.settings.subtitle }}
        </p>
      {% endif %}

      {% if show_view_all and view_all_pos != 'bottom' and header_align == 'center' %}
        <div class="category-grid-header__action category-grid-header__action--center" style="margin-top: 18px;">
          {{ view_all_element }}
        </div>
      {% endif %}
    </div>

    {% if show_view_all and view_all_pos != 'bottom' and header_align != 'center' %}
      <div class="category-grid-header__action">
        {{ view_all_element }}
      </div>
    {% endif %}
  </div>

  {% if display_format == 'slider' %}
    {%- comment -%} ================= SWIPER CAROUSEL ================= {%- endcomment -%}
    <div class="category-swiper-wrapper" id="CatSwiperWrap-{{ section_id }}">
      <div class="swiper category-swiper" id="CatSwiper-{{ section_id }}">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            <div class="swiper-slide category-swiper-slide">
              {% render 'category-card-item',
                block: block,
                card_style: card_style,
                scallop_color_type: scallop_color_type,
                scallop_custom_color: scallop_custom_color,
                forloop_index: forloop.index
              %}
            </div>
          {% endfor %}
        </div>

        {% if show_arrows and section.blocks.size > 2 %}
          <button
            type="button"
            class="category-swiper__nav category-swiper__nav--prev"
            aria-label="Previous categories"
          >
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 18l-6-6 6-6"/>
            </svg>
          </button>
          <button
            type="button"
            class="category-swiper__nav category-swiper__nav--next"
            aria-label="Next categories"
          >
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 18l6-6-6-6"/>
            </svg>
          </button>
        {% endif %}
      </div>
    </div>

  {% else %}
    {%- comment -%} ================= GRID LAYOUT ================= {%- endcomment -%}
    <div class="category-grid category-grid--style-{{ card_style }}">
      {% for block in section.blocks %}
        {% render 'category-card-item',
          block: block,
          card_style: card_style,
          scallop_color_type: scallop_color_type,
          scallop_custom_color: scallop_custom_color,
          forloop_index: forloop.index
        %}
      {% endfor %}
    </div>
  {% endif %}

  {% if show_view_all and view_all_pos == 'bottom' or show_view_all and view_all_pos == 'both' %}
    <div class="category-grid__footer-action">
      {{ view_all_element }}
    </div>
  {% endif %}
</div>

<style>
  #CategoryGrid-{{ section.id }} {
    position: relative;
  }

  /* Header Lockup */
  #CategoryGrid-{{ section.id }} .category-grid-header {
    margin-bottom: clamp(20px, 3.5vw, 36px);
  }

  #CategoryGrid-{{ section.id }} .category-grid-header--split {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    flex-wrap: wrap;
  }

  #CategoryGrid-{{ section.id }} .category-grid-header--left { text-align: left; }
  #CategoryGrid-{{ section.id }} .category-grid-header--center { text-align: center; }
  #CategoryGrid-{{ section.id }} .category-grid-header--right { text-align: right; }

  #CategoryGrid-{{ section.id }} .section-eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    margin-bottom: 8px;
    color: var(--yozo-rosewood, #BD7385);
  }

  #CategoryGrid-{{ section.id }} .section-eyebrow--uppercase {
    text-transform: uppercase;
  }

  #CategoryGrid-{{ section.id }} .section-eyebrow--serif_italic {
    font-family: var(--font-heading--family), Georgia, serif;
    font-style: italic;
    letter-spacing: 0.04em;
    font-size: 0.9375rem;
    font-weight: 400;
    text-transform: none;
  }

  #CategoryGrid-{{ section.id }} .section-eyebrow--pill {
    text-transform: uppercase;
    padding: 3px 10px;
    background: rgba(189, 115, 133, 0.12);
    border-radius: 20px;
  }

  #CategoryGrid-{{ section.id }} .section-title {
    font-family: var(--font-heading--family), serif;
    line-height: 1.2;
    margin: 0;
  }

  #CategoryGrid-{{ section.id }} .section-title--small { font-size: clamp(1.25rem, 2.2vw, 1.625rem); }
  #CategoryGrid-{{ section.id }} .section-title--medium { font-size: clamp(1.625rem, 3vw, 2.125rem); }
  #CategoryGrid-{{ section.id }} .section-title--large { font-size: clamp(2rem, 3.8vw, 2.75rem); }

  #CategoryGrid-{{ section.id }} .section-subtitle {
    margin: 8px 0 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    max-width: 560px;
  }

  /* View All Button Styles */
  #CategoryGrid-{{ section.id }} .category-grid__view-all-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--yozo-rosewood, #BD7385);
    text-decoration: none;
    transition: gap 0.25s ease, color 0.2s ease;
  }
  #CategoryGrid-{{ section.id }} .category-grid__view-all-link:hover {
    gap: 10px;
    color: var(--yozo-plum-dark, #2C1E26);
  }

  #CategoryGrid-{{ section.id }} .category-grid__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 22px;
    border-radius: 30px;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  #CategoryGrid-{{ section.id }} .category-grid__btn--outline {
    background: transparent;
    color: var(--yozo-plum-dark, #2C1E26);
    border: 1.5px solid var(--yozo-plum-dark, #2C1E26);
  }
  #CategoryGrid-{{ section.id }} .category-grid__btn--outline:hover {
    background: var(--yozo-plum-dark, #2C1E26);
    color: #FFFFFF;
    transform: translateY(-2px);
  }

  #CategoryGrid-{{ section.id }} .category-grid__btn--rosewood {
    background: var(--yozo-rosewood, #BD7385);
    color: #FFFFFF;
    border: 1.5px solid var(--yozo-rosewood, #BD7385);
  }
  #CategoryGrid-{{ section.id }} .category-grid__btn--rosewood:hover {
    background: #A86072;
    transform: translateY(-2px);
  }

  #CategoryGrid-{{ section.id }} .category-grid__btn--plum {
    background: var(--yozo-plum-dark, #2C1E26);
    color: #FFFFFF;
    border: 1.5px solid var(--yozo-plum-dark, #2C1E26);
  }
  #CategoryGrid-{{ section.id }} .category-grid__btn--plum:hover {
    background: #3F2B37;
    transform: translateY(-2px);
  }

  #CategoryGrid-{{ section.id }} .category-grid__footer-action {
    display: flex;
    justify-content: center;
    margin-top: clamp(24px, 4vw, 36px);
  }

  /* Swiper Slider Container & Navigation */
  #CategoryGrid-{{ section.id }} .category-swiper-wrapper {
    position: relative;
    width: 100%;
    overflow: visible;
  }

  #CategoryGrid-{{ section.id }} .category-swiper {
    position: relative;
    overflow: hidden;
    width: 100%;
    padding: 18px 4px 16px;
  }

  #CategoryGrid-{{ section.id }} .category-swiper-slide {
    height: auto;
    display: flex;
    justify-content: center;
  }

  #CategoryGrid-{{ section.id }} .category-swiper__nav {
    position: absolute;
    top: 42%;
    transform: translateY(-50%);
    z-index: 10;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(44, 30, 38, 0.72);
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.35);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.2);
    transition: all 0.25s ease;
  }

  #CategoryGrid-{{ section.id }} .category-swiper__nav:hover {
    background: rgba(44, 30, 38, 0.95);
    border-color: rgba(255, 255, 255, 0.7);
    transform: translateY(-50%) scale(1.08);
  }

  #CategoryGrid-{{ section.id }} .category-swiper__nav--prev { left: 4px; }
  #CategoryGrid-{{ section.id }} .category-swiper__nav--next { right: 4px; }

  #CategoryGrid-{{ section.id }} .category-swiper__nav.swiper-button-disabled {
    opacity: 0;
    pointer-events: none;
  }

  /* Scallop Flower Badge Styles (Matching Reference) */
  #CategoryGrid-{{ section.id }} .category-card--scallop-flower {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    text-decoration: none;
    width: 100%;
    max-width: var(--cat-badge-size, 145px);
    background: transparent;
    border: none;
    box-shadow: none;
    overflow: visible;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  #CategoryGrid-{{ section.id }} .category-card--scallop-flower:hover {
    transform: translateY(-4px);
  }

  #CategoryGrid-{{ section.id }} .category-card__scallop-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    max-width: var(--cat-badge-size, 145px);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: visible;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  #CategoryGrid-{{ section.id }} .category-card__scallop-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--scallop-fill, #FF5DA2);
    /* Clean subtle shadow with zero blurry colored halo */
    filter: drop-shadow(0 2px 5px rgba(0, 0, 0, 0.08));
    transition: filter 0.3s ease, transform 0.3s ease;
    pointer-events: none;
  }

  #CategoryGrid-{{ section.id }} .category-card--scallop-flower:hover .category-card__scallop-svg {
    filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.12));
    transform: scale(1.02);
  }

  #CategoryGrid-{{ section.id }} .category-card__scallop-media {
    position: relative;
    z-index: 2;
    width: 88%;
    height: 108%;
    margin-top: -10%;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    overflow: visible;
  }

  #CategoryGrid-{{ section.id }} .category-card__scallop-img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: 100%;
    object-fit: contain;
    background: transparent;
    filter: drop-shadow(0 6px 12px rgba(0, 0, 0, 0.16));
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), filter 0.35s ease;
    display: block;
  }

  #CategoryGrid-{{ section.id }} .category-card--scallop-flower:hover .category-card__scallop-img {
    transform: translateY(-6px) scale(1.06);
    filter: drop-shadow(0 10px 18px rgba(0, 0, 0, 0.24));
  }

  #CategoryGrid-{{ section.id }} .category-card__scallop-caption {
    margin-top: 14px;
    width: 100%;
    text-align: center;
  }

  #CategoryGrid-{{ section.id }} .category-card__scallop-title {
    font-family: var(--font-body--family), sans-serif;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--yozo-plum-dark, #2C1E26);
    line-height: 1.25;
    transition: color 0.2s ease;
    display: block;
  }

  #CategoryGrid-{{ section.id }} .category-card--scallop-flower:hover .category-card__scallop-title {
    color: var(--yozo-rosewood, #BD7385);
  }

  /* Grid Layout */
  #CategoryGrid-{{ section.id }} .category-grid {
    display: grid;
    gap: 24px 20px;
    width: 100%;
    grid-template-columns: repeat(var(--cat-cols-desktop, 6), 1fr);
    justify-items: center;
  }

  @media screen and (max-width: 989px) {
    #CategoryGrid-{{ section.id }} .category-grid {
      grid-template-columns: repeat(var(--cat-cols-tablet, 4), 1fr);
    }
  }

  @media screen and (max-width: 639px) {
    #CategoryGrid-{{ section.id }} .category-grid {
      grid-template-columns: repeat(var(--cat-cols-mobile, 2), 1fr);
    }
  }

  /* Standard Card Fallback */
  #CategoryGrid-{{ section.id }} .category-card--standard,
  #CategoryGrid-{{ section.id }} .category-card--circle,
  #CategoryGrid-{{ section.id }} .category-card--minimal {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    text-decoration: none;
    width: 100%;
    max-width: var(--cat-badge-size, 145px);
  }

  #CategoryGrid-{{ section.id }} .category-card--circle .category-card__scallop-svg {
    display: none;
  }

  #CategoryGrid-{{ section.id }} .category-card--circle .category-card__scallop-frame {
    border-radius: 50%;
    background-color: var(--scallop-fill, #FF5DA2);
    overflow: hidden;
  }
</style>

<script>
  (function () {
    function initCatSwiper() {
      const container = document.getElementById('CatSwiper-{{ section_id }}');
      if (!container) return;

      if (typeof Swiper === 'undefined') {
        setTimeout(initCatSwiper, 60);
        return;
      }

      if (container.swiper) {
        container.swiper.destroy(true, true);
      }

      const desktopSlides = parseFloat('{{ items_desktop | default: 6.5 }}');
      const tabletSlides = parseFloat('{{ items_tablet | default: 4.5 }}');
      const mobileSlides = parseFloat('{{ items_mobile | default: 2.3 }}');

      const config = {
        slidesPerView: mobileSlides,
        spaceBetween: 14,
        grabCursor: true,
        watchSlidesProgress: true,
        navigation: {
          prevEl: '#CatSwiperWrap-{{ section_id }} .category-swiper__nav--prev',
          nextEl: '#CatSwiperWrap-{{ section_id }} .category-swiper__nav--next',
        },
        breakpoints: {
          640: {
            slidesPerView: tabletSlides > 3 ? tabletSlides - 1 : tabletSlides,
            spaceBetween: 16,
          },
          750: {
            slidesPerView: tabletSlides,
            spaceBetween: 18,
          },
          1024: {
            slidesPerView: desktopSlides,
            spaceBetween: 22,
          }
        }
      };

      {% if enable_autoplay %}
        config.autoplay = {
          delay: {{ autoplay_speed | default: 5 | times: 1000 }},
          disableOnInteraction: false,
          pauseOnMouseEnter: true,
        };
      {% endif %}

      new Swiper(container, config);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCatSwiper);
    } else {
      initCatSwiper();
    }

    document.addEventListener('shopify:section:load', function (e) {
      if (e.target.contains(document.getElementById('CategoryGrid-{{ section.id }}'))) {
        initCatSwiper();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Shop by Category",
  "tag": "section",
  "class": "section-category-grid",
  "settings": [
    {
      "type": "header",
      "content": "Layout & Style"
    },
    {
      "type": "select",
      "id": "display_format",
      "label": "Layout style",
      "options": [
        { "value": "slider", "label": "Slider (Carousel)" },
        { "value": "grid", "label": "Grid" }
      ],
      "default": "slider"
    },
    {
      "type": "select",
      "id": "items_desktop",
      "label": "Items on desktop",
      "options": [
        { "value": "4", "label": "4 items" },
        { "value": "5", "label": "5 items" },
        { "value": "6", "label": "6 items" },
        { "value": "6.5", "label": "6.5 items (Peeking)" },
        { "value": "7", "label": "7 items" }
      ],
      "default": "6.5"
    },
    {
      "type": "select",
      "id": "items_tablet",
      "label": "Items on tablet",
      "options": [
        { "value": "3", "label": "3 items" },
        { "value": "3.5", "label": "3.5 items (Peeking)" },
        { "value": "4", "label": "4 items" },
        { "value": "4.5", "label": "4.5 items (Peeking)" }
      ],
      "default": "4.5"
    },
    {
      "type": "select",
      "id": "items_mobile",
      "label": "Items on mobile",
      "options": [
        { "value": "2", "label": "2 items" },
        { "value": "2.3", "label": "2.3 items (Peeking)" },
        { "value": "2.5", "label": "2.5 items (Peeking)" },
        { "value": "3", "label": "3 items" }
      ],
      "default": "2.3"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Badge style",
      "options": [
        { "value": "scallop_flower", "label": "Scallop flower badge" },
        { "value": "standard", "label": "Card" },
        { "value": "circle", "label": "Circle" },
        { "value": "minimal", "label": "Borderless" }
      ],
      "default": "scallop_flower"
    },
    {
      "type": "range",
      "id": "badge_size",
      "label": "Badge size",
      "min": 120,
      "max": 180,
      "step": 5,
      "unit": "px",
      "default": 145
    },
    {
      "type": "select",
      "id": "scallop_color_type",
      "label": "Badge color",
      "options": [
        { "value": "vibrant_pink", "label": "Vibrant pink" },
        { "value": "rosewood", "label": "Rosewood" },
        { "value": "pastel_cycle", "label": "Rainbow pastels" },
        { "value": "custom", "label": "Custom color" }
      ],
      "default": "vibrant_pink"
    },
    {
      "type": "color",
      "id": "scallop_custom_color",
      "label": "Custom badge color",
      "default": "#FF5DA2"
    },
    {
      "type": "header",
      "content": "Slider Controls"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show navigation arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Enable automatic slide change",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
