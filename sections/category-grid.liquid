{% doc %}
  Category Grid section for Kay Cosmetics.
  Displays beauty categories supporting native Shopify collections,
  custom images, titles, and links.
{% enddoc %}

<div
  class="section section--{{ section.settings.section_width }} category-grid-section spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="category-grid-header">
    {% if section.settings.eyebrow != blank %}
      <span class="section-eyebrow">{{ section.settings.eyebrow }}</span>
    {% endif %}
    {% if section.settings.title != blank %}
      <h2 class="section-title">{{ section.settings.title }}</h2>
    {% endif %}
    {% if section.settings.subtitle != blank %}
      <p class="section-subtitle">{{ section.settings.subtitle }}</p>
    {% endif %}
  </div>

  <div class="category-grid">
    {% for block in section.blocks %}
      {% liquid
        assign collection = block.settings.collection
        assign title = block.settings.title
        if title == blank and collection != blank
          assign title = collection.title
        endif
        if title == blank
          assign title = 'Category'
        endif

        assign link = block.settings.link
        if link == blank and collection != blank
          assign link = collection.url
        endif
        if link == blank
          assign link = '/collections/all'
        endif

        assign image = block.settings.image
        if image == blank and collection != blank and collection.image != blank
          assign image = collection.image
        elsif image == blank and collection != blank and collection.featured_image != blank
          assign image = collection.featured_image
        endif
      %}

      <a href="{{ link }}" class="category-card" {{ block.shopify_attributes }}>
        <div class="category-card__media">
          {% if image != blank %}
            {{
              image
              | image_url: width: 800
              | image_tag:
                widths: '300, 500, 800',
                class: 'category-card__image',
                alt: title,
                loading: 'lazy'
            }}
          {% elsif block.settings.image_asset != blank %}
            <img
              src="{{ block.settings.image_asset | asset_url }}"
              alt="{{ title }}"
              class="category-card__image"
              loading="lazy"
              width="400"
              height="500"
            >
          {% else %}
            {{ 'collection-1' | placeholder_svg_tag: 'category-card__image' }}
          {% endif %}
        </div>

        <div class="category-card__content">
          <h3 class="category-card__title">
            <span>{{ title }}</span>
            <span class="category-card__arrow" aria-hidden="true">&rarr;</span>
          </h3>
          {% if block.settings.tagline != blank %}
            <p class="category-card__tagline">{{ block.settings.tagline }}</p>
          {% endif %}
        </div>
      </a>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Shop by Category",
  "tag": "section",
  "class": "section-category-grid",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Collections"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Browse our multi-brand selection across key cosmetics categories."
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom title (optional)"
        },
        {
          "type": "text",
          "id": "tagline",
          "label": "Tagline / Subtext",
          "default": "Explore collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image"
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Asset image name (optional)",
          "info": "Optional theme asset file if no collection or uploaded image is available"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Category",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "Makeup",
            "tagline": "Lipsticks, Foundations & Palettes",
            "image_asset": "cat-makeup.jpg"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Skincare",
            "tagline": "Cleansers, Serums & Creams",
            "image_asset": "cat-skincare.jpg"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Haircare",
            "tagline": "Shampoos, Oils & Treatments",
            "image_asset": "cat-haircare.jpg"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Fragrance",
            "tagline": "Perfumes & Fragrance Mists",
            "image_asset": "cat-fragrance.jpg"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Beauty Tools",
            "tagline": "Brushes, Sponges & Accessories",
            "image_asset": "cat-tools.jpg"
          }
        }
      ]
    }
  ]
}
{% endschema %}
