{% doc %}
  Category Grid section for Kay Cosmetics.
  Displays beauty categories supporting native Shopify collections,
  custom images, titles, badges, product counts, and multiple layout styles.
{% enddoc %}

{% liquid
  assign section_id = section.id | replace: '-', '_'
  assign bg_color = section.settings.section_bg_color
  assign header_align = section.settings.header_alignment | default: 'left'
  assign col_desktop = section.settings.columns_desktop | default: 5
  assign col_tablet = section.settings.columns_tablet | default: '3'
  assign mobile_layout = section.settings.mobile_layout | default: 'carousel'
  assign card_style = section.settings.card_style | default: 'standard'
  assign img_ratio = section.settings.image_ratio | default: '4_5'
  assign img_fit = section.settings.image_fit | default: 'cover'
  assign card_radius = section.settings.card_border_radius | default: 8
  assign card_border = section.settings.card_border | default: 'subtle'
  assign card_shadow = section.settings.card_shadow | default: 'hover'
  assign hover_effect = section.settings.hover_effect | default: 'lift_and_zoom'
  assign card_title_font = section.settings.card_title_font | default: 'body'
  assign card_title_size = section.settings.card_title_size | default: 15
  assign card_title_weight = section.settings.card_title_weight | default: '600'
  assign card_title_color = section.settings.card_title_color | default: '#2c1e26'
  assign card_tagline_color = section.settings.card_tagline_color | default: '#6b5c65'
  assign show_tagline = section.settings.show_tagline
  assign show_count = section.settings.show_count
  assign show_arrow = section.settings.show_arrow
  assign arrow_style = section.settings.arrow_style | default: 'inline'
  assign arrow_color = section.settings.arrow_color | default: '#bd7385'
  assign content_align = section.settings.content_alignment | default: 'left'
  assign content_pad = section.settings.content_padding | default: 14
  assign card_bg_type = section.settings.card_bg_type | default: 'pastel_cycle'
  assign card_custom_bg = section.settings.card_custom_bg | default: '#ffffff'
  assign col_gap = section.settings.column_gap | default: 16
  assign row_gap = section.settings.row_gap | default: 20
  assign show_view_all = section.settings.show_view_all
  assign view_all_pos = section.settings.view_all_position | default: 'header'
  assign view_all_style = section.settings.view_all_style | default: 'link_arrow'
  assign view_all_label = section.settings.view_all_label | default: 'View All Collections'
  assign view_all_link = section.settings.view_all_link | default: '/collections'
%}

<div
  id="CategoryGrid-{{ section.id }}"
  class="section section--{{ section.settings.section_width }} category-grid-section spacing-style"
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% if bg_color != blank and bg_color != 'rgba(0,0,0,0)' %}background-color: {{ bg_color }};{% endif %}
    --cat-cols-desktop: {{ col_desktop }};
    --cat-cols-tablet: {{ col_tablet }};
    --cat-col-gap: {{ col_gap }}px;
    --cat-row-gap: {{ row_gap }}px;
    --cat-card-radius: {{ card_radius }}px;
    --cat-content-pad: {{ content_pad }}px;
    --cat-title-size: {{ card_title_size }}px;
    --cat-title-weight: {{ card_title_weight }};
    --cat-title-color: {{ card_title_color }};
    --cat-tagline-color: {{ card_tagline_color }};
    --cat-arrow-color: {{ arrow_color }};
    --cat-subtitle-max-w: {{ section.settings.subtitle_max_width | default: 560 }}px;
  "
>
  {%- capture view_all_element -%}
    {% if show_view_all and view_all_link != blank %}
      {% if view_all_style == 'link_arrow' %}
        <a href="{{ view_all_link }}" class="category-grid__view-all-link">
          <span>{{ view_all_label }}</span>
          <span class="category-grid__view-all-arrow" aria-hidden="true">&rarr;</span>
        </a>
      {% elsif view_all_style == 'button_outline' %}
        <a href="{{ view_all_link }}" class="category-grid__btn category-grid__btn--outline">
          <span>{{ view_all_label }}</span>
          <span class="category-grid__btn-arrow" aria-hidden="true">&rarr;</span>
        </a>
      {% elsif view_all_style == 'button_rosewood' %}
        <a href="{{ view_all_link }}" class="category-grid__btn category-grid__btn--rosewood">
          <span>{{ view_all_label }}</span>
          <span class="category-grid__btn-arrow" aria-hidden="true">&rarr;</span>
        </a>
      {% elsif view_all_style == 'button_plum' %}
        <a href="{{ view_all_link }}" class="category-grid__btn category-grid__btn--plum">
          <span>{{ view_all_label }}</span>
          <span class="category-grid__btn-arrow" aria-hidden="true">&rarr;</span>
        </a>
      {% endif %}
    {% endif %}
  {%- endcapture -%}

  <div class="category-grid-header category-grid-header--{{ header_align }} {% if show_view_all and view_all_pos != 'bottom' and header_align != 'center' %}category-grid-header--split{% endif %}">
    <div class="category-grid-header__text">
      {% if section.settings.eyebrow != blank %}
        <span
          class="section-eyebrow section-eyebrow--{{ section.settings.eyebrow_style | default: 'uppercase' }}"
          {% if section.settings.eyebrow_color != blank %}
            style="color: {{ section.settings.eyebrow_color }};"
          {% endif %}
        >
          {{ section.settings.eyebrow }}
        </span>
      {% endif %}

      {% if section.settings.title != blank %}
        <{{ section.settings.heading_tag | default: 'h2' }}
          class="section-title section-title--{{ section.settings.heading_size | default: 'medium' }}"
          {% if section.settings.heading_color != blank %}
            style="color: {{ section.settings.heading_color }};"
          {% endif %}
        >
          {{ section.settings.title }}
        </{{ section.settings.heading_tag | default: 'h2' }}>
      {% endif %}

      {% if section.settings.subtitle != blank %}
        <p
          class="section-subtitle"
          style="
            {% if section.settings.subtitle_color != blank %}color: {{ section.settings.subtitle_color }};{% endif %}
            max-width: var(--cat-subtitle-max-w);
            {% if header_align == 'center' %}margin-left: auto; margin-right: auto;{% elsif header_align == 'right' %}margin-left: auto;{% endif %}
          "
        >
          {{ section.settings.subtitle }}
        </p>
      {% endif %}

      {% if show_view_all and view_all_pos != 'bottom' and header_align == 'center' %}
        <div class="category-grid-header__action category-grid-header__action--center" style="margin-top: 18px;">
          {{ view_all_element }}
        </div>
      {% endif %}
    </div>

    {% if show_view_all and view_all_pos != 'bottom' and header_align != 'center' %}
      <div class="category-grid-header__action">
        {{ view_all_element }}
      </div>
    {% endif %}
  </div>

  <div
    class="
      category-grid
      category-grid--cols-{{ col_desktop }}
      category-grid--tablet-{{ col_tablet }}
      category-grid--mobile-{{ mobile_layout }}
      category-grid--style-{{ card_style }}
      category-grid--border-{{ card_border }}
      category-grid--shadow-{{ card_shadow }}
      category-grid--hover-{{ hover_effect }}
      category-grid--ratio-{{ img_ratio }}
      category-grid--align-{{ content_align }}
      category-grid--font-{{ card_title_font }}
    "
  >
    {% for block in section.blocks %}
      {% liquid
        assign collection = block.settings.collection
        assign title = block.settings.title
        if title == blank and collection != blank
          assign title = collection.title
        endif
        if title == blank
          assign title = 'Category'
        endif

        assign link = block.settings.link
        if link == blank and collection != blank
          assign link = collection.url
        endif
        if link == blank
          assign link = '/collections/all'
        endif

        assign image = block.settings.image
        if image == blank and collection != blank and collection.image != blank
          assign image = collection.image
        elsif image == blank and collection != blank and collection.featured_image != blank
          assign image = collection.featured_image
        endif

        assign product_count = 0
        if collection != blank
          assign product_count = collection.all_products_count
        endif

        assign custom_card_bg = ''
        if block.settings.card_bg_override != blank and block.settings.card_bg_override != 'rgba(0,0,0,0)'
          assign custom_card_bg = block.settings.card_bg_override
        elsif card_bg_type == 'white'
          assign custom_card_bg = '#FFFFFF'
        elsif card_bg_type == 'canvas'
          assign custom_card_bg = 'var(--yozo-canvas, #FAF5F2)'
        elsif card_bg_type == 'transparent'
          assign custom_card_bg = 'transparent'
        elsif card_bg_type == 'custom'
          assign custom_card_bg = card_custom_bg
        endif
      %}

      <a
        href="{{ link }}"
        class="category-card category-card--{{ card_style }} {% if card_bg_type == 'pastel_cycle' and custom_card_bg == '' %}category-card--pastel-cycle{% endif %}"
        {% if custom_card_bg != '' %}
          style="--card-bg-override: {{ custom_card_bg }};"
        {% endif %}
        {{ block.shopify_attributes }}
      >
        <div class="category-card__media category-card__media--fit-{{ img_fit }}">
          {% if block.settings.badge_text != blank %}
            <span
              class="category-card__badge"
              style="
                --badge-text: {{ block.settings.badge_color | default: '#bd7385' }};
                --badge-bg: {{ block.settings.badge_bg_color | default: '#ffffff' }};
              "
            >
              {{ block.settings.badge_text }}
            </span>
          {% endif %}

          {% if image != blank %}
            {{
              image
              | image_url: width: 800
              | image_tag:
                widths: '250, 400, 600, 800',
                class: 'category-card__image',
                alt: title,
                loading: 'lazy'
            }}
          {% elsif block.settings.image_asset != blank %}
            <img
              src="{{ block.settings.image_asset | asset_url }}"
              alt="{{ title }}"
              class="category-card__image"
              loading="lazy"
              width="400"
              height="500"
            >
          {% else %}
            {{ 'collection-1' | placeholder_svg_tag: 'category-card__image' }}
          {% endif %}

          {% if card_style == 'overlay' %}
            <div class="category-card__overlay-scrim"></div>
          {% endif %}
        </div>

        <div class="category-card__content">
          <div class="category-card__header-wrap">
            <h3 class="category-card__title">
              <span>{{ title }}</span>
              {% if show_arrow and arrow_style == 'inline' %}
                <span class="category-card__arrow category-card__arrow--inline" aria-hidden="true">&rarr;</span>
              {% endif %}
            </h3>

            {% if show_arrow and arrow_style == 'circle_icon' %}
              <span class="category-card__arrow category-card__arrow--circle" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </span>
            {% endif %}
          </div>

          {% if show_tagline and block.settings.tagline != blank %}
            <p class="category-card__tagline">{{ block.settings.tagline }}</p>
          {% endif %}

          {% if show_count and collection != blank %}
            <span class="category-card__count">
              {{ product_count }} {{ product_count | pluralize: 'product', 'products' }}
            </span>
          {% endif %}

          {% if show_arrow and arrow_style == 'pill' %}
            <span class="category-card__arrow category-card__arrow--pill">
              Explore &rarr;
            </span>
          {% endif %}
        </div>
      </a>
    {% endfor %}
  </div>

  {% if show_view_all and view_all_pos == 'bottom' or show_view_all and view_all_pos == 'both' %}
    <div class="category-grid__footer-action">
      {{ view_all_element }}
    </div>
  {% endif %}
</div>

<style>
  /* ==========================================================================
     Category Grid Scoped Styling for Kay Cosmetics
     ========================================================================== */

  #CategoryGrid-{{ section.id }} {
    position: relative;
  }

  /* Header Lockup */
  #CategoryGrid-{{ section.id }} .category-grid-header {
    margin-bottom: clamp(20px, 3.5vw, 36px);
  }

  #CategoryGrid-{{ section.id }} .category-grid-header--left {
    text-align: left;
  }
  #CategoryGrid-{{ section.id }} .category-grid-header--center {
    text-align: center;
  }
  #CategoryGrid-{{ section.id }} .category-grid-header--right {
    text-align: right;
  }

  #CategoryGrid-{{ section.id }} .category-grid-header--split {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
  }

  /* Eyebrow Styles */
  #CategoryGrid-{{ section.id }} .section-eyebrow--uppercase {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--yozo-rosewood, #BD7385);
    margin-bottom: 6px;
  }

  #CategoryGrid-{{ section.id }} .section-eyebrow--serif_italic {
    display: inline-block;
    font-family: var(--font-heading--family), serif;
    font-style: italic;
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-weight: 400;
    letter-spacing: 0.01em;
    color: var(--yozo-rosewood, #BD7385);
    margin-bottom: 4px;
    text-transform: none;
  }

  #CategoryGrid-{{ section.id }} .section-eyebrow--pill {
    display: inline-block;
    background-color: rgba(189, 115, 133, 0.12);
    color: var(--yozo-rosewood, #BD7385);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: 9999px;
    margin-bottom: 8px;
    border: 1px solid rgba(189, 115, 133, 0.18);
  }

  /* Heading Sizes */
  #CategoryGrid-{{ section.id }} .section-title {
    font-family: var(--font-heading--family), serif;
    font-weight: var(--font-heading--weight, 600);
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--yozo-plum-dark, #2C1E26);
    margin: 0 0 8px 0;
  }

  #CategoryGrid-{{ section.id }} .section-title--small {
    font-size: clamp(1.35rem, 2.3vw, 1.75rem);
  }
  #CategoryGrid-{{ section.id }} .section-title--medium {
    font-size: clamp(1.6rem, 3vw, 2.25rem);
  }
  #CategoryGrid-{{ section.id }} .section-title--large {
    font-size: clamp(1.95rem, 3.8vw, 2.75rem);
  }
  #CategoryGrid-{{ section.id }} .section-title--xlarge {
    font-size: clamp(2.35rem, 4.6vw, 3.25rem);
  }

  #CategoryGrid-{{ section.id }} .section-subtitle {
    font-size: 0.9375rem;
    color: var(--yozo-text-muted, #6B5C65);
    line-height: 1.55;
    margin: 0;
  }

  /* View All Button & Link Styles */
  #CategoryGrid-{{ section.id }} .category-grid__view-all-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--yozo-rosewood, #BD7385);
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
    white-space: nowrap;
    padding-block: 4px;
  }
  #CategoryGrid-{{ section.id }} .category-grid__view-all-link:hover {
    color: var(--yozo-rosewood-hover, #A75D6F);
  }
  #CategoryGrid-{{ section.id }} .category-grid__view-all-link:hover .category-grid__view-all-arrow {
    transform: translateX(4px);
  }
  #CategoryGrid-{{ section.id }} .category-grid__view-all-arrow {
    transition: transform 0.2s ease;
    display: inline-block;
  }

  #CategoryGrid-{{ section.id }} .category-grid__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 22px;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition: all 0.25s ease;
    white-space: nowrap;
    cursor: pointer;
  }
  #CategoryGrid-{{ section.id }} .category-grid__btn--outline {
    background: transparent;
    color: var(--yozo-plum-dark, #2C1E26);
    border: 1.5px solid var(--yozo-plum-dark, #2C1E26);
  }
  #CategoryGrid-{{ section.id }} .category-grid__btn--outline:hover {
    background: var(--yozo-plum-dark, #2C1E26);
    color: #FFFFFF;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(44, 30, 38, 0.15);
  }

  #CategoryGrid-{{ section.id }} .category-grid__btn--rosewood {
    background: var(--yozo-rosewood, #BD7385);
    color: #FFFFFF;
    border: 1.5px solid var(--yozo-rosewood, #BD7385);
    box-shadow: 0 4px 14px rgba(189, 115, 133, 0.25);
  }
  #CategoryGrid-{{ section.id }} .category-grid__btn--rosewood:hover {
    background: var(--yozo-rosewood-hover, #A75D6F);
    border-color: var(--yozo-rosewood-hover, #A75D6F);
    color: #FFFFFF;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(189, 115, 133, 0.35);
  }

  #CategoryGrid-{{ section.id }} .category-grid__btn--plum {
    background: var(--yozo-plum-dark, #2C1E26);
    color: #FFFFFF;
    border: 1.5px solid var(--yozo-plum-dark, #2C1E26);
    box-shadow: 0 4px 14px rgba(44, 30, 38, 0.18);
  }
  #CategoryGrid-{{ section.id }} .category-grid__btn--plum:hover {
    background: #3F2B37;
    border-color: #3F2B37;
    color: #FFFFFF;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(44, 30, 38, 0.28);
  }

  #CategoryGrid-{{ section.id }} .category-grid__footer-action {
    display: flex;
    justify-content: center;
    margin-top: clamp(24px, 4vw, 36px);
  }

  /* ==========================================================================
     Grid Layout & Responsive Columns
     ========================================================================== */

  #CategoryGrid-{{ section.id }} .category-grid {
    display: grid;
    gap: var(--cat-row-gap) var(--cat-col-gap);
    width: 100%;
  }

  /* Desktop columns */
  #CategoryGrid-{{ section.id }} .category-grid--cols-2 { grid-template-columns: repeat(2, 1fr); }
  #CategoryGrid-{{ section.id }} .category-grid--cols-3 { grid-template-columns: repeat(3, 1fr); }
  #CategoryGrid-{{ section.id }} .category-grid--cols-4 { grid-template-columns: repeat(4, 1fr); }
  #CategoryGrid-{{ section.id }} .category-grid--cols-5 { grid-template-columns: repeat(5, 1fr); }
  #CategoryGrid-{{ section.id }} .category-grid--cols-6 { grid-template-columns: repeat(6, 1fr); }

  /* Tablet columns */
  @media screen and (min-width: 750px) and (max-width: 989px) {
    #CategoryGrid-{{ section.id }} .category-grid--tablet-2 { grid-template-columns: repeat(2, 1fr) !important; }
    #CategoryGrid-{{ section.id }} .category-grid--tablet-3 { grid-template-columns: repeat(3, 1fr) !important; }
    #CategoryGrid-{{ section.id }} .category-grid--tablet-4 { grid-template-columns: repeat(4, 1fr) !important; }
  }

  /* Mobile Layouts */
  @media screen and (max-width: 749px) {
    #CategoryGrid-{{ section.id }} .category-grid--mobile-grid_1 {
      grid-template-columns: 1fr !important;
      gap: 12px;
    }
    #CategoryGrid-{{ section.id }} .category-grid--mobile-grid_2 {
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 10px;
    }
    #CategoryGrid-{{ section.id }} .category-grid--mobile-carousel {
      display: flex !important;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding-bottom: 8px;
      gap: 12px;
      margin-inline: -16px;
      padding-inline: 16px;
    }
    #CategoryGrid-{{ section.id }} .category-grid--mobile-carousel::-webkit-scrollbar {
      display: none;
    }
    #CategoryGrid-{{ section.id }} .category-grid--mobile-carousel .category-card {
      flex: 0 0 68%;
      max-width: 280px;
      scroll-snap-align: start;
    }
  }

  /* ==========================================================================
     Category Card Core Styles
     ========================================================================== */

  #CategoryGrid-{{ section.id }} .category-card {
    display: flex;
    flex-direction: column;
    border-radius: var(--cat-card-radius);
    overflow: hidden;
    background-color: var(--card-bg-override, var(--yozo-card-bg, #FFFFFF));
    text-decoration: none;
    position: relative;
    box-sizing: border-box;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.35s ease,
                box-shadow 0.35s ease;
  }

  /* Borders */
  #CategoryGrid-{{ section.id }} .category-grid--border-subtle .category-card {
    border: 1px solid var(--yozo-border-subtle, #EFE6E8);
  }
  #CategoryGrid-{{ section.id }} .category-grid--border-soft .category-card {
    border: 1px solid var(--yozo-border-medium, #DECED2);
  }
  #CategoryGrid-{{ section.id }} .category-grid--border-none .category-card {
    border: none;
  }

  /* Shadows */
  #CategoryGrid-{{ section.id }} .category-grid--shadow-hover .category-card:hover {
    box-shadow: 0 12px 28px -6px rgba(189, 115, 133, 0.16),
                0 4px 10px rgba(44, 30, 38, 0.04);
  }
  #CategoryGrid-{{ section.id }} .category-grid--shadow-always .category-card {
    box-shadow: 0 6px 18px rgba(44, 30, 38, 0.06);
  }
  #CategoryGrid-{{ section.id }} .category-grid--shadow-always .category-card:hover {
    box-shadow: 0 14px 32px -4px rgba(189, 115, 133, 0.2);
  }

  /* Hover Animations */
  #CategoryGrid-{{ section.id }} .category-grid--hover-lift_and_zoom .category-card:hover {
    transform: translateY(-4px);
    border-color: var(--yozo-rosewood, #BD7385);
  }
  #CategoryGrid-{{ section.id }} .category-grid--hover-lift_and_zoom .category-card:hover .category-card__image {
    transform: scale(1.05);
  }

  #CategoryGrid-{{ section.id }} .category-grid--hover-zoom_only .category-card:hover .category-card__image {
    transform: scale(1.06);
  }

  #CategoryGrid-{{ section.id }} .category-grid--hover-lift_only .category-card:hover {
    transform: translateY(-4px);
    border-color: var(--yozo-rosewood, #BD7385);
  }

  #CategoryGrid-{{ section.id }} .category-grid--hover-glow .category-card:hover {
    border-color: var(--yozo-rosewood, #BD7385);
    box-shadow: 0 0 0 3px rgba(189, 115, 133, 0.2), 0 8px 20px rgba(44, 30, 38, 0.08);
  }

  /* ==========================================================================
     Media Container & Aspect Ratios
     ========================================================================== */

  #CategoryGrid-{{ section.id }} .category-card__media {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: var(--yozo-pastel-peach, #FBF1ED);
  }

  /* Aspect Ratio presets */
  #CategoryGrid-{{ section.id }} .category-grid--ratio-4_5 .category-card__media { aspect-ratio: 4 / 5; }
  #CategoryGrid-{{ section.id }} .category-grid--ratio-3_4 .category-card__media { aspect-ratio: 3 / 4; }
  #CategoryGrid-{{ section.id }} .category-grid--ratio-1_1 .category-card__media { aspect-ratio: 1 / 1; }
  #CategoryGrid-{{ section.id }} .category-grid--ratio-16_9 .category-card__media { aspect-ratio: 16 / 9; }
  #CategoryGrid-{{ section.id }} .category-grid--ratio-circle .category-card__media {
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    width: 85%;
    margin: 12px auto 0;
  }

  /* Media Background Pastels for standard palette rotation */
  #CategoryGrid-{{ section.id }} .category-card--pastel-cycle:nth-child(5n + 1) .category-card__media {
    background-color: var(--yozo-pastel-peach, #FBF1ED);
