{%- comment -%}
  Kay Cosmetics - Premium Hero Swiper Section
  Features:
  - 100% Full-bleed edge-to-edge layout (zero side margins, zero dead whitespace)
  - True 50/50 split layout on desktop (Left: Centered editorial text | Right: Full-bleed studio photography)
  - Right media column goes edge-to-edge: NO card frame, NO rounded corners, NO border, NO outer padding
  - Uses Theme Settings typography tokens (no duplicate external font imports)
  - Configurable heading weight and font styling (no hardcoded heavy weights)
  - Brand color palette buttons (Rosewood #BD7385 & Deep Plum #2C1E26, rounded corners)
  - Flush edge navigation tabs at viewport borders
  - Zero pause/play button
  - Full mobile responsiveness: stacked layout with full-width media and legible typography
  - Comprehensive Shopify Theme Customizer controls for every single aspect
{%- endcomment -%}

{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign section_id = section.id
  assign full_width = section.settings.full_width
  assign height_desktop = section.settings.section_height_desktop
  assign custom_height_desktop = section.settings.custom_height_desktop
  assign height_mobile = section.settings.section_height_mobile
  assign custom_height_mobile = section.settings.custom_height_mobile
  assign arrow_style = section.settings.arrow_style | default: 'edge_tab'
  assign autoplay = section.settings.autoplay_enabled
  assign autoplay_delay = section.settings.autoplay_delay | times: 1000
  assign pause_on_hover = section.settings.pause_on_hover
  assign transition_effect = section.settings.transition_effect
  assign transition_speed = section.settings.transition_speed
  assign loop = section.settings.loop
  assign show_arrows = section.settings.show_arrows
  assign arrows_desktop_only = section.settings.arrows_desktop_only
  assign show_pagination = section.settings.show_pagination
-%}

<style>
  #HeroSwiper-{{ section_id }} {
    --hero-bg-default: {{ section.settings.section_bg_color | default: '#FAF5F2' }};
    --hero-arrow-color: {{ section.settings.arrow_color | default: '#2C1E26' }};
    --hero-arrow-bg: {{ section.settings.arrow_bg_color | default: '#FFFFFF' }};
    --hero-arrow-hover-bg: {{ section.settings.arrow_hover_bg_color | default: '#FFFFFF' }};
    --hero-arrow-hover-color: {{ section.settings.arrow_hover_color | default: '#BD7385' }};
    --hero-pagination-color: {{ section.settings.pagination_color | default: '#BD7385' }};
    --hero-pagination-inactive: {{ section.settings.pagination_inactive_color | default: 'rgba(44, 30, 38, 0.22)' }};
    --hero-padding-top: {{ section.settings.padding_top | default: 0 }}px;
    --hero-padding-bottom: {{ section.settings.padding_bottom | default: 0 }}px;

    {% case height_desktop %}
      {% when 'small' %}
        --hero-min-height-desktop: 480px;
      {% when 'medium' %}
        --hero-min-height-desktop: 580px;
      {% when 'large' %}
        --hero-min-height-desktop: 680px;
      {% when 'fullscreen' %}
        --hero-min-height-desktop: calc(100vh - var(--header-height, 70px));
      {% when 'custom' %}
        --hero-min-height-desktop: {{ custom_height_desktop }}px;
      {% else %}
        --hero-min-height-desktop: 580px;
    {% endcase %}

    {% case height_mobile %}
      {% when 'small' %}
        --hero-min-height-mobile: 440px;
      {% when 'medium' %}
        --hero-min-height-mobile: 520px;
      {% when 'large' %}
        --hero-min-height-mobile: 620px;
      {% when 'fullscreen' %}
        --hero-min-height-mobile: calc(100dvh - var(--header-height, 60px));
      {% when 'custom' %}
        --hero-min-height-mobile: {{ custom_height_mobile }}px;
      {% else %}
        --hero-min-height-mobile: auto;
    {% endcase %}
  }

  .hero-swiper-wrapper {
    position: relative;
    width: 100%;
    background-color: var(--hero-bg-default);
    padding-top: var(--hero-padding-top);
    padding-bottom: var(--hero-padding-bottom);
    overflow: hidden;
    margin: 0;
    box-sizing: border-box;
  }

  /* Full Bleed Container: Zero Side Margins or Inset Padding */
  .hero-swiper-container {
    position: relative;
    width: 100%;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  .hero-swiper-container.container--page-width {
    max-width: var(--page-width, 1340px);
    margin: 0 auto;
    padding: 0 24px;
  }

  .hero-swiper {
    position: relative;
    width: 100%;
    overflow: hidden;
    list-style: none;
    padding: 0;
    margin: 0;
    z-index: 1;
  }

  .hero-slide {
    position: relative;
    width: 100%;
    min-height: var(--hero-min-height-mobile);
    box-sizing: border-box;
    overflow: hidden;
    margin: 0;
    padding: 0;
  }

  @media screen and (min-width: 990px) {
    .hero-slide {
      min-height: var(--hero-min-height-desktop);
    }
  }

  /* 50/50 Full Bleed Split Layout */
  .hero-slide--split_image_right {
    display: flex;
    flex-direction: column-reverse;
    width: 100%;
    margin: 0;
    padding: 0;
  }

  .hero-slide--split_image_left {
    display: flex;
    flex-direction: column;
    width: 100%;
    margin: 0;
    padding: 0;
  }

  @media screen and (min-width: 990px) {
    .hero-slide--split_image_right {
      display: grid;
      grid-template-columns: 50% 50%;
      align-items: stretch;
      flex-direction: row;
    }
    .hero-slide--split_image_left {
      display: grid;
      grid-template-columns: 50% 50%;
      align-items: stretch;
      flex-direction: row-reverse;
    }
  }

  /* Content Column (Left 50%) */
  .hero-slide__content-col {
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    z-index: 2;
    box-sizing: border-box;
    padding: 44px 24px 48px;
  }

  @media screen and (min-width: 768px) and (max-width: 989px) {
    .hero-slide__content-col {
      padding: 50px 36px 54px;
    }
  }

  @media screen and (min-width: 990px) {
    .hero-slide__content-col {
      padding: 60px 52px;
    }
  }

  @media screen and (min-width: 1300px) {
    .hero-slide__content-col {
      padding: 70px 68px;
    }
  }

  /* Content Alignment Variations */
  .hero-slide__content-col--center {
    align-items: center;
    text-align: center;
  }
  .hero-slide__content-col--center .hero-slide__inner {
    margin: 0 auto;
    text-align: center;
  }
  .hero-slide__content-col--center .hero-slide__btn-group {
    justify-content: center;
  }

  .hero-slide__content-col--left {
    align-items: flex-start;
    text-align: left;
  }
  .hero-slide__content-col--left .hero-slide__inner {
    margin-left: 0;
    margin-right: auto;
    text-align: left;
  }
  .hero-slide__content-col--left .hero-slide__btn-group {
    justify-content: flex-start;
  }

  .hero-slide__content-col--right {
    align-items: flex-end;
    text-align: right;
  }
  .hero-slide__content-col--right .hero-slide__inner {
    margin-left: auto;
    margin-right: 0;
    text-align: right;
  }
  .hero-slide__content-col--right .hero-slide__btn-group {
    justify-content: flex-end;
  }

  .hero-slide__inner {
    width: 100%;
    max-width: 540px;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.6s ease;
  }

  /* Media Column (Right 50% Full-Bleed - No Card, No Border, Edge-to-Edge) */
  .hero-slide__media-col {
    width: 100%;
    position: relative;
    overflow: hidden;
    z-index: 1;
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    border: none;
    border-radius: 0;
  }

  @media screen and (max-width: 989px) {
    .hero-slide__media-col {
      height: clamp(280px, 48vw, 420px);
      min-height: 280px;
    }
  }

  @media screen and (min-width: 990px) {
    .hero-slide__media-col {
      height: 100%;
      min-height: var(--hero-min-height-desktop);
    }
  }

  .hero-slide__image-wrap {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    margin: 0;
    padding: 0;
    border: none;
    border-radius: 0;
    box-shadow: none;
  }

  .hero-slide__image-wrap picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-slide__image {
    width: 100%;
    height: 100%;
    object-fit: var(--slide-img-fit, cover);
    object-position: var(--slide-img-pos, center center);
    display: block;
    margin: 0;
    padding: 0;
    border: none;
    border-radius: 0;
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-slide.swiper-slide-active .hero-slide__image {
    transform: scale(1.02);
  }

  /* Overlay Full-Bleed Layout */
  .hero-slide--overlay {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 60px 24px;
  }

  .hero-slide--overlay .hero-slide__media-col {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .hero-slide--overlay .hero-slide__content-col {
    position: relative;
    z-index: 3;
    max-width: var(--page-width, 1340px);
    padding: 60px 24px;
  }

  /* Overlay Tint Layer */
  .hero-slide__overlay-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
  }

  /* Editorial Eyebrow Typography (Uses Theme Accent/Heading font tokens) */
  .hero-slide__eyebrow {
    display: inline-block;
    margin-bottom: 12px;
  }

  .hero-slide__eyebrow--serif_italic {
    font-family: var(--font-accent--family, var(--font-heading--family, serif));
    font-style: italic;
    font-weight: var(--font-accent--weight, 400);
    font-size: clamp(22px, 2.2vw, 32px);
    line-height: 1.2;
    letter-spacing: 0.02em;
    padding-bottom: 2px;
  }

  .hero-slide__eyebrow--badge {
    display: inline-flex;
    align-items: center;
    padding: 5px 14px;
    border-radius: 999px;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 600;
    background: rgba(189, 115, 133, 0.12);
    border: 1px solid rgba(189, 115, 133, 0.22);
  }

  .hero-slide__eyebrow--sans {
    font-family: var(--font-body--family, sans-serif);
    text-transform: uppercase;
    font-size: 0.8125rem;
    letter-spacing: 0.18em;
    font-weight: 600;
  }

  /* Headline (Uses Theme Heading Font directly, respects theme weight & settings) */
  .hero-slide__heading {
    margin: 0 0 16px 0;
    font-family: var(--font-heading--family, inherit);
    font-style: var(--font-heading--style, normal);
    font-weight: var(--slide-heading-weight, var(--font-heading--weight, 600));
    line-height: var(--font-heading--line-height, 1.15);
    letter-spacing: var(--letter-spacing-sm, 0.02em);
    word-break: normal;
    overflow-wrap: break-word;
  }

  .hero-slide__heading--uppercase {
    text-transform: uppercase;
  }

  /* Subheading */
  .hero-slide__subheading {
    margin: 0 0 28px 0;
    font-family: var(--font-body--family, inherit);
    line-height: 1.6;
    font-weight: var(--font-body--weight, 400);
    max-width: 48ch;
  }

  .hero-slide__subheading p {
    margin: 0;
  }

  /* CTA Buttons (Brand palette: Rosewood & Deep Plum, a bit rounder) */
  .hero-slide__btn-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    margin-top: 6px;
  }

  .hero-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-family: var(--font-body--family, inherit);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    height: 48px;
    padding: 0 28px;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    box-sizing: border-box;
    position: relative;
    overflow: hidden;
  }

  .hero-btn:active {
    transform: scale(0.98);
  }

  /* Button Corner Radius ("a bit rounder") */
  .hero-btn--shape-rounded {
    border-radius: 6px;
  }

  .hero-btn--shape-soft {
    border-radius: 10px;
  }

  .hero-btn--shape-pill {
    border-radius: 999px;
  }

  .hero-btn--shape-sharp {
    border-radius: 0px;
  }

  /* Primary Rosewood (#BD7385) */
  .hero-btn--primary-rosewood {
    background-color: var(--yozo-rosewood, #BD7385);
    color: #FFFFFF !important;
    border: 1.5px solid var(--yozo-rosewood, #BD7385);
    box-shadow: 0 4px 14px rgba(189, 115, 133, 0.25);
  }

  .hero-btn--primary-rosewood:hover {
    background-color: #AA6172;
    border-color: #AA6172;
    color: #FFFFFF !important;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(189, 115, 133, 0.35);
  }

  /* Deep Plum (#2C1E26) */
  .hero-btn--deep-plum {
    background-color: var(--yozo-plum-dark, #2C1E26);
    color: #FFFFFF !important;
    border: 1.5px solid var(--yozo-plum-dark, #2C1E26);
    box-shadow: 0 4px 14px rgba(44, 30, 38, 0.18);
  }

  .hero-btn--deep-plum:hover {
    background-color: #3F2B37;
    border-color: #3F2B37;
    color: #FFFFFF !important;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(44, 30, 38, 0.28);
  }

  /* Deep Plum Outline */
  .hero-btn--outline {
    background-color: transparent;
    color: var(--yozo-plum-dark, #2C1E26) !important;
    border: 1.5px solid var(--yozo-plum-dark, #2C1E26);
  }

  .hero-btn--outline:hover {
    background-color: var(--yozo-plum-dark, #2C1E26);
    color: #FFFFFF !important;
    border-color: var(--yozo-plum-dark, #2C1E26);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(44, 30, 38, 0.15);
  }

  /* Rosewood Outline */
  .hero-btn--outline-rosewood {
    background-color: transparent;
    color: var(--yozo-rosewood, #BD7385) !important;
    border: 1.5px solid var(--yozo-rosewood, #BD7385);
  }

  .hero-btn--outline-rosewood:hover {
    background-color: var(--yozo-rosewood, #BD7385);
    color: #FFFFFF !important;
    border-color: var(--yozo-rosewood, #BD7385);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(189, 115, 133, 0.25);
  }

  /* Pure White */
  .hero-btn--white {
    background-color: #FFFFFF;
    color: var(--yozo-plum-dark, #2C1E26) !important;
    border: 1.5px solid #FFFFFF;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
  }

  .hero-btn--white:hover {
    background-color: rgba(255, 255, 255, 0.95);
    transform: translateY(-2px);
  }

  /* Custom Buttons */
  .hero-btn--custom-1 {
    background-color: var(--btn1-bg);
    color: var(--btn1-text) !important;
    border: 1.5px solid var(--btn1-border);
  }
  .hero-btn--custom-1:hover {
    filter: brightness(0.92);
    transform: translateY(-2px);
  }

  .hero-btn--custom-2 {
    background-color: var(--btn2-bg);
    color: var(--btn2-text) !important;
    border: 1.5px solid var(--btn2-border);
  }
  .hero-btn--custom-2:hover {
    filter: brightness(0.92);
    transform: translateY(-2px);
  }

  @media screen and (max-width: 640px) {
    .hero-slide__btn-group.btn-group--stack-mobile {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }
    .hero-slide__btn-group.btn-group--stack-mobile .hero-btn {
      width: 100%;
    }
  }

  /* Navigation Arrows */
  .hero-swiper__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    margin-top: 0;
    border: none;
    padding: 0;
    outline: none;
  }

  .hero-swiper__nav::after {
    display: none !important;
  }

  .hero-swiper__nav svg {
    stroke-width: 2.2;
    stroke: currentColor;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.25s ease;
  }

  /* Flush Edge Tabs */
  .hero-swiper__nav--edge_tab {
    width: 38px;
    height: 64px;
    background: #FFFFFF;
    color: var(--hero-arrow-color);
    box-shadow: 0 2px 14px rgba(0, 0, 0, 0.12);
  }

  .hero-swiper__nav--prev.hero-swiper__nav--edge_tab {
    left: 0;
    border-radius: 0 6px 6px 0;
    border: 1px solid rgba(44, 30, 38, 0.08);
    border-left: none;
  }

  .hero-swiper__nav--next.hero-swiper__nav--edge_tab {
    right: 0;
    border-radius: 6px 0 0 6px;
    border: 1px solid rgba(44, 30, 38, 0.08);
    border-right: none;
  }

  .hero-swiper__nav--edge_tab:hover {
    background: #FFFFFF;
    color: var(--hero-arrow-hover-color, #BD7385);
  }

  .hero-swiper__nav--prev.hero-swiper__nav--edge_tab:hover svg {
    transform: translateX(-2px);
  }

  .hero-swiper__nav--next.hero-swiper__nav--edge_tab:hover svg {
    transform: translateX(2px);
  }

  /* Floating Circle Style */
  .hero-swiper__nav--floating_circle {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--hero-arrow-bg, rgba(255, 255, 255, 0.9));
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(44, 30, 38, 0.1);
    color: var(--hero-arrow-color, #2C1E26);
    box-shadow: 0 4px 18px rgba(44, 30, 38, 0.08);
  }

  .hero-swiper__nav--prev.hero-swiper__nav--floating_circle {
    left: 20px;
  }

  .hero-swiper__nav--next.hero-swiper__nav--floating_circle {
    right: 20px;
  }

  @media screen and (min-width: 1400px) {
    .hero-swiper__nav--prev.hero-swiper__nav--floating_circle {
      left: 28px;
    }
    .hero-swiper__nav--next.hero-swiper__nav--floating_circle {
      right: 28px;
    }
  }

  .hero-swiper__nav--floating_circle:hover {
    background: var(--hero-arrow-hover-bg, #FFFFFF);
    color: var(--hero-arrow-hover-color, #BD7385);
    transform: translateY(-50%) scale(1.06);
    box-shadow: 0 8px 24px rgba(189, 115, 133, 0.22);
  }

  @media screen and (max-width: 768px) {
    .hero-swiper__nav--edge_tab {
      width: 32px;
      height: 48px;
    }
    .hero-swiper__nav--edge_tab svg {
      width: 16px;
      height: 16px;
    }
  }

  {% if arrows_desktop_only %}
    @media screen and (max-width: 989px) {
      .hero-swiper__nav {
        display: none !important;
      }
    }
  {% endif %}

  /* Pagination */
  .hero-swiper__pagination {
    position: absolute;
    bottom: 20px !important;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    z-index: 10;
  }

  .hero-swiper__pagination .swiper-pagination-bullet {
    width: 8px;
    height: 8px;
    margin: 0 !important;
    background: var(--hero-pagination-inactive);
    border-radius: 999px;
    opacity: 1;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
  }

  .hero-swiper__pagination .swiper-pagination-bullet-active {
    width: 28px;
    background: var(--hero-pagination-color);
  }

  /* Global Slide Clickable Area */
  .hero-slide__link-mask {
    position: absolute;
    inset: 0;
    z-index: 4;
  }
</style>

<div
  id="HeroSwiper-{{ section_id }}"
  class="hero-swiper-wrapper"
  data-section-id="{{ section_id }}"
>
  <div class="hero-swiper-container {% unless full_width %}container--page-width{% endunless %}">
    <div
      class="swiper hero-swiper"
      id="Swiper-{{ section_id }}"
      data-effect="{{ transition_effect }}"
      data-speed="{{ transition_speed }}"
      data-autoplay="{{ autoplay }}"
      data-autoplay-delay="{{ autoplay_delay }}"
      data-pause-on-hover="{{ pause_on_hover }}"
      data-loop="{{ loop }}"
    >
      <div class="swiper-wrapper">
        {%- for block in section.blocks -%}
          {%- liquid
            assign slide_layout = block.settings.layout_type | default: 'split_image_right'
            assign bg_color = block.settings.slide_bg_color | default: '#FAF5F2'
            assign img_fit = block.settings.image_fit | default: 'cover'
            assign img_pos = block.settings.image_position | default: 'center center'

            assign eyebrow_style = block.settings.eyebrow_style | default: 'serif_italic'
            assign eyebrow_text = block.settings.eyebrow_text
            assign eyebrow_color = block.settings.eyebrow_color | default: '#BD7385'
            assign eyebrow_size = block.settings.eyebrow_size | default: 30

            assign heading = block.settings.heading
            assign heading_tag = block.settings.heading_tag | default: 'h1'
            assign heading_weight = block.settings.heading_weight | default: 'inherit'
            assign heading_case = block.settings.heading_case | default: 'uppercase'
            assign heading_color = block.settings.heading_color | default: '#2C1E26'
            assign heading_size_desktop = block.settings.heading_size_desktop | default: 40
            assign heading_size_mobile = block.settings.heading_size_mobile | default: 26

            assign subheading = block.settings.subheading
            assign subheading_color = block.settings.subheading_color | default: '#574A52'
            assign subheading_size = block.settings.subheading_size | default: 15
            assign max_width = block.settings.content_max_width | default: 540
            assign text_align = block.settings.text_alignment | default: 'center'

            assign btn1_label = block.settings.button_1_label
            assign btn1_link = block.settings.button_1_link
            assign btn1_style = block.settings.button_1_style | default: 'primary-rosewood'

            assign btn2_label = block.settings.button_2_label
            assign btn2_link = block.settings.button_2_link
            assign btn2_style = block.settings.button_2_style | default: 'deep-plum'

            assign btn_shape = block.settings.buttons_shape | default: 'rounded'
            assign btn_stack = block.settings.buttons_stack_mobile

            assign show_overlay = block.settings.show_overlay
            assign overlay_color = block.settings.overlay_color | default: '#2C1E26'
            assign overlay_opacity = block.settings.overlay_opacity | default: 20
          -%}

          <div
            class="swiper-slide hero-slide hero-slide--{{ slide_layout }}"
            style="
              background-color: {{ bg_color }};
              --slide-img-fit: {{ img_fit }};
              --slide-img-pos: {{ img_pos }};
              {% if heading_weight != 'inherit' %}--slide-heading-weight: {{ heading_weight }};{% endif %}
              --btn1-bg: {{ block.settings.button_1_bg_color | default: '#BD7385' }};
              --btn1-text: {{ block.settings.button_1_text_color | default: '#FFFFFF' }};
              --btn1-border: {{ block.settings.button_1_border_color | default: '#BD7385' }};
              --btn2-bg: {{ block.settings.button_2_bg_color | default: '#2C1E26' }};
              --btn2-text: {{ block.settings.button_2_text_color | default: '#FFFFFF' }};
              --btn2-border: {{ block.settings.button_2_border_color | default: '#2C1E26' }};
            "
            {{ block.shopify_attributes }}
            data-slide-index="{{ forloop.index0 }}"
          >
            {%- comment -%} Content Column (Left 50%) {%- endcomment -%}
            <div class="hero-slide__content-col hero-slide__content-col--{{ text_align }}">
              <div
                class="hero-slide__inner"
                style="max-width: {{ max_width }}px;"
              >
                {%- if eyebrow_text != blank -%}
                  <span
                    class="hero-slide__eyebrow hero-slide__eyebrow--{{ eyebrow_style }}"
                    style="color: {{ eyebrow_color }}; {% if eyebrow_style != 'badge' %}font-size: {{ eyebrow_size }}px;{% endif %}"
                  >
                    {{ eyebrow_text }}
                  </span>
                {%- endif -%}

                {%- if heading != blank -%}
                  <{{ heading_tag }}
                    class="hero-slide__heading {% if heading_case == 'uppercase' %}hero-slide__heading--uppercase{% endif %}"
                    style="
                      color: {{ heading_color }};
                      font-size: clamp({{ heading_size_mobile }}px, 3.2vw, {{ heading_size_desktop }}px);
                    "
                  >
                    {{ heading }}
                  </{{ heading_tag }}>
                {%- endif -%}

                {%- if subheading != blank -%}
                  <div
                    class="hero-slide__subheading"
                    style="color: {{ subheading_color }}; font-size: {{ subheading_size }}px;"
                  >
                    {{ subheading }}
                  </div>
                {%- endif -%}

                {%- if btn1_label != blank or btn2_label != blank -%}
                  <div class="hero-slide__btn-group {% if btn_stack %}btn-group--stack-mobile{% endif %}">
                    {%- if btn1_label != blank -%}
                      <a
                        href="{{ btn1_link | default: routes.all_products_collection_url }}"
                        class="hero-btn hero-btn--{{ btn1_style }} hero-btn--shape-{{ btn_shape }}"
                      >
                        {{ btn1_label }}
                      </a>
                    {%- endif -%}

                    {%- if btn2_label != blank -%}
                      <a
                        href="{{ btn2_link | default: routes.all_products_collection_url }}"
                        class="hero-btn hero-btn--{{ btn2_style }} hero-btn--shape-{{ btn_shape }}"
                      >
                        {{ btn2_label }}
                      </a>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            </div>

            {%- comment -%} Media Column (Right 50% Full-Bleed - Exactly like Reference) {%- endcomment -%}
            <div class="hero-slide__media-col">
              <div class="hero-slide__image-wrap">
                {%- if block.settings.image != blank -%}
                  <picture>
                    {%- if block.settings.mobile_image != blank -%}
                      <source
                        media="(max-width: 749px)"
                        srcset="{{ block.settings.mobile_image | image_url: width: 800 }}"
                      >
                    {%- endif -%}
                    <img
                      src="{{ block.settings.image | image_url: width: 1600 }}"
                      alt="{{ block.settings.image.alt | default: heading | escape }}"
                      class="hero-slide__image"
                      {% if forloop.first %}
                        loading="eager"
                        fetchpriority="high"
                      {% else %}
                        loading="lazy"
                      {% endif %}
                      width="{{ block.settings.image.width }}"
                      height="{{ block.settings.image.height }}"
                    >
                  </picture>
                {%- else -%}
                  {%- liquid
                    assign fallback_asset = 'hero-slide-1.jpg'
                    if forloop.index == 2
                      assign fallback_asset = 'hero-slide-2.jpg'
                    elsif forloop.index > 2
                      assign fallback_asset = 'hero-beauty.jpg'
                    endif
                  -%}
                  <img
                    src="{{ fallback_asset | asset_url }}"
                    alt="{{ shop.name }} - {{ heading | escape }}"
                    class="hero-slide__image"
                    {% if forloop.first %}
                      loading="eager"
                      fetchpriority="high"
                    {% else %}
                      loading="lazy"
                    {% endif %}
                    width="1400"
                    height="950"
                  >
                {%- endif -%}
              </div>

              {%- if show_overlay -%}
                <div
                  class="hero-slide__overlay-layer"
                  style="
                    background-color: {{ overlay_color }};
                    opacity: {{ overlay_opacity | divided_by: 100.0 }};
                  "
                ></div>
              {%- endif -%}
            </div>

            {%- if block.settings.slide_link != blank and btn1_label == blank and btn2_label == blank -%}
              <a
                href="{{ block.settings.slide_link }}"
                class="hero-slide__link-mask"
                aria-label="{{ heading | escape }}"
              ></a>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      {%- comment -%} Navigation Arrows {%- endcomment -%}
      {%- if show_arrows and section.blocks.size > 1 -%}
        <button
          type="button"
          class="hero-swiper__nav hero-swiper__nav--prev hero-swiper__nav--{{ arrow_style }}"
          aria-label="Previous slide"
        >
          <svg viewBox="0 0 24 24" width="20" height="20">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button
          type="button"
          class="hero-swiper__nav hero-swiper__nav--next hero-swiper__nav--{{ arrow_style }}"
          aria-label="Next slide"
        >
          <svg viewBox="0 0 24 24" width="20" height="20">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      {%- endif -%}

      {%- comment -%} Pagination {%- endcomment -%}
      {%- if show_pagination and section.blocks.size > 1 -%}
        <div class="swiper-pagination hero-swiper__pagination"></div>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  (function () {
    function setupSwiper() {
      const el = document.getElementById('Swiper-{{ section_id }}');
      if (!el || typeof Swiper === 'undefined') {
        setTimeout(setupSwiper, 50);
        return;
      }

      if (el.swiper) {
        el.swiper.destroy(true, true);
      }

      const effect = el.dataset.effect || 'slide';
      const speed = parseInt(el.dataset.speed, 10) || 700;
      const autoplayEnabled = el.dataset.autoplay === 'true';
      const autoplayDelay = parseInt(el.dataset.autoplayDelay, 10) || 5000;
      const pauseOnHover = el.dataset.pauseOnHover === 'true';
      const loop = el.dataset.loop === 'true';

      const swiperConfig = {
        effect: effect,
        speed: speed,
        loop: loop,
        grabCursor: true,
        watchSlidesProgress: true,
        navigation: {
          nextEl: '#HeroSwiper-{{ section_id }} .hero-swiper__nav--next',
          prevEl: '#HeroSwiper-{{ section_id }} .hero-swiper__nav--prev',
        },
        pagination: {
          el: '#HeroSwiper-{{ section_id }} .hero-swiper__pagination',
          clickable: true,
        },
        keyboard: {
          enabled: true,
          onlyInViewport: true,
        },
        a11y: {
          prevSlideMessage: 'Previous slide',
          nextSlideMessage: 'Next slide',
        },
      };

      if (effect === 'fade') {
        swiperConfig.fadeEffect = { crossFade: true };
      }

      if (autoplayEnabled) {
        swiperConfig.autoplay = {
          delay: autoplayDelay,
          disableOnInteraction: false,
          pauseOnMouseEnter: pauseOnHover,
        };
      }

      const swiperInstance = new Swiper(el, swiperConfig);

      // Theme Editor Support
      document.addEventListener('shopify:block:select', function (e) {
        if (e.target && e.target.closest('#HeroSwiper-{{ section_id }}')) {
          const slideIndex = e.target.dataset.slideIndex;
          if (slideIndex !== undefined) {
            if (swiperInstance.params.loop) {
              swiperInstance.slideToLoop(parseInt(slideIndex, 10));
            } else {
              swiperInstance.slideTo(parseInt(slideIndex, 10));
            }
          }
        }
      });

      document.addEventListener('shopify:section:load', function (e) {
        if (e.detail && e.detail.sectionId === '{{ section_id }}') {
          setupSwiper();
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupSwiper);
    } else {
      setupSwiper();
    }
  })();
</script>

