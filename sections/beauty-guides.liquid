{% doc %}
  Beauty & Shopping Guides section for Kay Cosmetics.
  Supports linking to native Shopify blog articles or custom guide links.
{% enddoc %}

<div
  class="section section--{{ section.settings.section_width }} beauty-guides-section spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="category-grid-header">
    {% if section.settings.eyebrow != blank %}
      <span class="section-eyebrow">{{ section.settings.eyebrow }}</span>
    {% endif %}
    {% if section.settings.title != blank %}
      <h2 class="section-title">{{ section.settings.title }}</h2>
    {% endif %}
    {% if section.settings.subtitle != blank %}
      <p class="section-subtitle">{{ section.settings.subtitle }}</p>
    {% endif %}
  </div>

  <div class="guides-grid">
    {% for block in section.blocks %}
      {% liquid
        assign article = block.settings.article
        assign title = block.settings.title
        if title == blank and article != blank
          assign title = article.title
        endif

        assign summary = block.settings.summary
        if summary == blank and article != blank
          assign summary = article.excerpt_or_content | strip_html | truncatewords: 20
        endif

        assign link = block.settings.link
        if link == blank and article != blank
          assign link = article.url
        endif
        if link == blank
          assign link = '/collections/all'
        endif

        assign image = block.settings.image
        if image == blank and article != blank and article.image != blank
          assign image = article.image
        endif
      %}

      <a href="{{ link }}" class="guide-card" {{ block.shopify_attributes }}>
        <div class="guide-card__media">
          {% if image != blank %}
            {{
              image
              | image_url: width: 600
              | image_tag:
                widths: '300, 600',
                class: 'guide-card__image',
                alt: title,
                loading: 'lazy'
            }}
          {% elsif block.settings.image_asset != blank %}
            <img
              src="{{ block.settings.image_asset | asset_url }}"
              alt="{{ title }}"
              class="guide-card__image"
              loading="lazy"
              width="600"
              height="375"
            >
          {% else %}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'guide-card__image' }}
          {% endif %}
        </div>

        <div class="guide-card__content">
          {% if block.settings.category_label != blank %}
            <span class="guide-card__tag">{{ block.settings.category_label }}</span>
          {% endif %}

          <h3 class="guide-card__title">{{ title }}</h3>

          {% if summary != blank %}
            <p class="guide-card__summary">{{ summary }}</p>
          {% endif %}

          <span class="guide-card__read-more">
            Learn More <span aria-hidden="true">&rarr;</span>
          </span>
        </div>
      </a>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Beauty & Shopping Guides",
  "tag": "section",
  "class": "section-beauty-guides",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Advice & Guides"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Beauty & Shopping Guides"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Helpful tips on selecting products and building everyday routines."
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "guide",
      "name": "Guide Card",
      "settings": [
        {
          "type": "article",
          "id": "article",
          "label": "Link Blog Article (optional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Skincare Routines"
        },
        {
          "type": "text",
          "id": "category_label",
          "label": "Category Label",
          "default": "Skincare"
        },
        {
          "type": "textarea",
          "id": "summary",
          "label": "Summary",
          "default": "Simple steps to build an effective daily skincare routine suited to your skin type."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image"
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Asset image name (optional)",
          "default": "cat-skincare.jpg"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Beauty & Shopping Guides",
      "blocks": [
        {
          "type": "guide",
          "settings": {
            "title": "Daily Skincare Routines",
            "category_label": "Skincare",
            "summary": "Practical steps for morning and evening routines designed for humid and dry climates.",
            "image_asset": "cat-skincare.jpg"
          }
        },
        {
          "type": "guide",
          "settings": {
            "title": "Choosing Products for Your Skin Type",
            "category_label": "Skin Guidance",
            "summary": "How to choose between hydrating serums, clarifying cleansers, and barrier creams.",
            "image_asset": "cat-makeup.jpg"
          }
        },
        {
          "type": "guide",
          "settings": {
            "title": "Everyday Makeup Essentials",
            "category_label": "Makeup Guide",
            "summary": "Core cosmetics for a natural, long-wearing everyday look.",
            "image_asset": "cat-tools.jpg"
          }
        }
      ]
    }
  ]
}
{% endschema %}
