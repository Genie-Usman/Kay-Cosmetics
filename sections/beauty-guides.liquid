        { "value": "natural", "label": "Natural Adapt" }
      ],
      "default": "16_10"
    },
    {
      "type": "checkbox",
      "id": "image_zoom_on_hover",
      "label": "Subtle image zoom on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Card Typography & Links"
    },
    {
      "type": "color",
      "id": "card_tag_color",
      "label": "Category tag color",
      "default": "#BD7385"
    },
    {
      "type": "select",
      "id": "card_title_font",
      "label": "Card title font family",
      "options": [
        { "value": "heading", "label": "Besley Serif (Luxury Brand Heading)" },
        { "value": "body", "label": "Figtree Sans (Body Font)" }
      ],
      "default": "heading"
    },
    {
      "type": "range",
      "id": "card_title_size",
      "label": "Card title font size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 17
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Card title color",
      "default": "#2C1E26"
    },
    {
      "type": "color",
      "id": "card_summary_color",
      "label": "Card summary color",
      "default": "#6B5C65"
    },
    {
      "type": "range",
      "id": "card_summary_size",
      "label": "Card summary font size",
      "min": 12,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "checkbox",
      "id": "show_read_more",
      "label": "Show 'Learn More' link",
      "default": true
    },
    {
      "type": "text",
      "id": "read_more_text",
      "label": "Default 'Learn More' text",
      "default": "Learn More"
    },
    {
      "type": "color",
      "id": "read_more_color",
      "label": "'Learn More' link color",
      "default": "#BD7385"
    },
    {
      "type": "header",
      "content": "Mobile Layout"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile card arrangement",
      "options": [
        { "value": "stacked", "label": "Stacked vertical column" },
        { "value": "scroll", "label": "Horizontal swipeable carousel" }
      ],
      "default": "stacked"
    },
    {
      "type": "header",
      "content": "Section Spacing & Dividers"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
