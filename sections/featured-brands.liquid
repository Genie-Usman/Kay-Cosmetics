{% doc %}
  Featured Brands section for Kay Cosmetics.
  Allows store owners to showcase brands they carry (such as Staplex).
  Fully merchant-configurable with brand collections, logos, and a link to the Brands directory.
{% enddoc %}

{% liquid
  assign show_view_all = section.settings.show_view_all
  assign view_all_label = section.settings.view_all_label | default: 'View All Brands'
  assign view_all_link = section.settings.view_all_link | default: '/pages/brands'
  assign view_all_style = section.settings.view_all_style | default: 'link_arrow'
  assign header_align = section.settings.header_alignment | default: 'left'
%}

<div
  id="FeaturedBrands-{{ section.id }}"
  class="section section--{{ section.settings.section_width }} featured-brands-section spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  {%- capture view_all_element -%}
    {% if show_view_all and view_all_link != blank %}
      {% if view_all_style == 'link_arrow' %}
        <a href="{{ view_all_link }}" class="featured-brands__view-all-link">
          <span>{{ view_all_label }}</span>
          <span class="featured-brands__arrow" aria-hidden="true">&rarr;</span>
        </a>
      {% elsif view_all_style == 'button_outline' %}
        <a href="{{ view_all_link }}" class="featured-brands__btn featured-brands__btn--outline">
          <span>{{ view_all_label }}</span>
          <span class="featured-brands__arrow" aria-hidden="true">&rarr;</span>
        </a>
      {% elsif view_all_style == 'button_rosewood' %}
        <a href="{{ view_all_link }}" class="featured-brands__btn featured-brands__btn--rosewood">
          <span>{{ view_all_label }}</span>
          <span class="featured-brands__arrow" aria-hidden="true">&rarr;</span>
        </a>
      {% endif %}
    {% endif %}
  {%- endcapture -%}

  <div class="featured-brands-header featured-brands-header--{{ header_align }} {% if show_view_all and header_align != 'center' %}featured-brands-header--split{% endif %}">
    <div class="featured-brands-header__text">
      {% if section.settings.eyebrow != blank %}
        <span class="section-eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
      {% if section.settings.title != blank %}
        <h2 class="section-title">{{ section.settings.title }}</h2>
      {% endif %}
      {% if section.settings.subtitle != blank %}
        <p class="section-subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}

      {% if show_view_all and header_align == 'center' %}
        <div class="featured-brands-header__action-center" style="margin-top: 14px;">
          {{ view_all_element }}
        </div>
      {% endif %}
    </div>

    {% if show_view_all and header_align != 'center' %}
      <div class="featured-brands-header__action">
        {{ view_all_element }}
      </div>
    {% endif %}
  </div>

  <div class="brands-grid">
    {% for block in section.blocks %}
      {% liquid
        assign collection = block.settings.collection
        assign brand_name = block.settings.brand_name
        if brand_name == blank and collection != blank
          assign brand_name = collection.title
        endif
        if brand_name == blank
          assign brand_name = 'Brand Name'
        endif

        assign tagline = block.settings.tagline
        assign link = block.settings.link
        if link == blank and collection != blank
          assign link = collection.url
        endif
        if link == blank
          assign link = '/collections/all'
        endif

        assign logo = block.settings.logo
        if logo == blank and collection != blank and collection.image != blank
          assign logo = collection.image
        elsif logo == blank and collection != blank and collection.featured_image != blank
          assign logo = collection.featured_image
        endif
      %}

      <a href="{{ link }}" class="brand-card" {{ block.shopify_attributes }}>
        {% if logo != blank %}
          {{
            logo
            | image_url: width: 300
            | image_tag:
              widths: '150, 300',
              class: 'brand-card__logo',
              alt: brand_name,
              loading: 'lazy'
          }}
        {% else %}
          <h3 class="brand-card__name">{{ brand_name }}</h3>
        {% endif %}

        {% if tagline != blank %}
          <p class="brand-card__tagline">{{ tagline }}</p>
        {% endif %}
      </a>
    {% endfor %}
  </div>
</div>

<style>
  #FeaturedBrands-{{ section.id }} .featured-brands-header {
    margin-bottom: clamp(20px, 3.5vw, 36px);
  }
  #FeaturedBrands-{{ section.id }} .featured-brands-header--center {
    text-align: center;
  }
  #FeaturedBrands-{{ section.id }} .featured-brands-header--left {
    text-align: left;
  }
  #FeaturedBrands-{{ section.id }} .featured-brands-header--split {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    flex-wrap: wrap;
  }
  #FeaturedBrands-{{ section.id }} .featured-brands__view-all-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--yozo-rosewood, #BD7385);
    text-decoration: none;
    transition: color 0.2s ease;
    white-space: nowrap;
    padding-block: 4px;
  }
  #FeaturedBrands-{{ section.id }} .featured-brands__view-all-link:hover {
    color: var(--yozo-rosewood-hover, #A75D6F);
  }
  #FeaturedBrands-{{ section.id }} .featured-brands__arrow {
    display: inline-block;
    transition: transform 0.2s ease;
  }
  #FeaturedBrands-{{ section.id }} .featured-brands__view-all-link:hover .featured-brands__arrow,
  #FeaturedBrands-{{ section.id }} .featured-brands__btn:hover .featured-brands__arrow {
    transform: translateX(4px);
  }
  #FeaturedBrands-{{ section.id }} .featured-brands__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 22px;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: all 0.25s ease;
    white-space: nowrap;
  }
  #FeaturedBrands-{{ section.id }} .featured-brands__btn--outline {
    background: transparent;
    color: var(--yozo-plum-dark, #2C1E26);
    border: 1.5px solid var(--yozo-plum-dark, #2C1E26);
  }
  #FeaturedBrands-{{ section.id }} .featured-brands__btn--outline:hover {
    background: var(--yozo-plum-dark, #2C1E26);
    color: #FFFFFF;
    transform: translateY(-2px);
  }
  #FeaturedBrands-{{ section.id }} .featured-brands__btn--rosewood {
    background: var(--yozo-rosewood, #BD7385);
    color: #FFFFFF;
    border: 1.5px solid var(--yozo-rosewood, #BD7385);
    box-shadow: 0 4px 14px rgba(189, 115, 133, 0.25);
  }
  #FeaturedBrands-{{ section.id }} .featured-brands__btn--rosewood:hover {
    background: var(--yozo-rosewood-hover, #A75D6F);
    border-color: var(--yozo-rosewood-hover, #A75D6F);
    color: #FFFFFF;
    transform: translateY(-2px);
  }
</style>

{% schema %}
{
  "name": "Featured Brands",
  "tag": "section",
  "class": "section-featured-brands",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Brand Partners"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Brands We Carry"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Explore cosmetics and beauty products available through Kay Cosmetics."
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "View All Button"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Button label",
      "default": "View All Brands"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "Button link",
      "default": "/pages/brands"
    },
    {
      "type": "select",
      "id": "view_all_style",
      "label": "Button style",
      "options": [
        { "value": "link_arrow", "label": "Text link with arrow" },
        { "value": "button_outline", "label": "Outline button" },
        { "value": "button_rosewood", "label": "Rosewood filled button" }
      ],
      "default": "link_arrow"
    },
    {
      "type": "header",
      "content": "Section Layout & Spacing"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Brand collection"
        },
        {
          "type": "text",
          "id": "brand_name",
          "label": "Brand Name",
          "default": "Brand Name"
        },
        {
          "type": "text",
          "id": "tagline",
          "label": "Tagline (optional)"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Brand Logo (optional)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Brand Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Brands",
      "blocks": [
        {
          "type": "brand",
          "settings": {
            "brand_name": "Staplex",
            "tagline": "Cosmetics & Skincare"
          }
        }
      ]
    }
  ]
}
{% endschema %}
