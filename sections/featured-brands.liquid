{% doc %}
  Featured Brands section for Kay Cosmetics.
  Supports both the Editorial Banner Slider (Swiper) and Compact Logo Grid.
  Features wide campaign banners, custom colored bottom callout bars, and smooth touch-swipe.
{% enddoc %}

<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer="defer"></script>

{% liquid
  assign section_id = section.id | replace: '-', '_'
  assign layout_style = section.settings.layout_style | default: 'banner_slider'
  assign show_view_all = section.settings.show_view_all
  assign view_all_label = section.settings.view_all_label | default: 'View All Brands'
  assign view_all_link = section.settings.view_all_link | default: '/pages/brands'
  assign view_all_style = section.settings.view_all_style | default: 'link_arrow'
  assign header_align = section.settings.header_alignment | default: 'left'
  assign slides_desktop = section.settings.slides_desktop | default: '2.8'
  assign slides_tablet = section.settings.slides_tablet | default: '2'
  assign slides_mobile = section.settings.slides_mobile | default: '1.2'
  assign slide_gap = section.settings.slide_gap | default: 20
  assign card_radius = section.settings.card_border_radius | default: 12
  assign banner_ratio = section.settings.banner_aspect_ratio | default: '16_9'
  assign bar_layout = section.settings.bar_layout | default: 'split'
  assign bar_padding_y = section.settings.bar_padding_vertical | default: 12
  assign headline_font = section.settings.headline_font | default: 'serif'
  assign headline_case = section.settings.headline_casing | default: 'uppercase'
  assign arrow_style = section.settings.arrow_style | default: 'luxury_white'
  assign autoplay_enabled = section.settings.enable_autoplay
  assign autoplay_speed = section.settings.autoplay_speed | default: 5
  assign show_arrows = section.settings.show_arrows
%}

<div
  id="FeaturedBrands-{{ section.id }}"
  class="section section--{{ section.settings.section_width }} featured-brands-section spacing-style"
  style="
    {% render 'spacing-style', settings: section.settings %}
    --brand-card-radius: {{ card_radius }}px;
  "
>
  {%- capture view_all_element -%}
    {% if show_view_all and view_all_link != blank %}
      {% if view_all_style == 'link_arrow' %}
        <a href="{{ view_all_link }}" class="featured-brands__view-all-link">
          <span>{{ view_all_label }}</span>
          <span class="featured-brands__arrow" aria-hidden="true">&rarr;</span>
        </a>
      {% elsif view_all_style == 'button_outline' %}
        <a href="{{ view_all_link }}" class="featured-brands__btn featured-brands__btn--outline">
          <span>{{ view_all_label }}</span>
          <span class="featured-brands__arrow" aria-hidden="true">&rarr;</span>
        </a>
      {% elsif view_all_style == 'button_rosewood' %}
        <a href="{{ view_all_link }}" class="featured-brands__btn featured-brands__btn--rosewood">
          <span>{{ view_all_label }}</span>
          <span class="featured-brands__arrow" aria-hidden="true">&rarr;</span>
        </a>
      {% endif %}
    {% endif %}
  {%- endcapture -%}

  <div class="featured-brands-header featured-brands-header--{{ header_align }} {% if show_view_all and header_align != 'center' %}featured-brands-header--split{% endif %}">
    <div class="featured-brands-header__text">
      {% if section.settings.eyebrow != blank %}
        <span class="section-eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
      {% if section.settings.title != blank %}
        <h2 class="section-title">{{ section.settings.title }}</h2>
      {% endif %}
      {% if section.settings.subtitle != blank %}
        <p class="section-subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}

      {% if show_view_all and header_align == 'center' %}
        <div class="featured-brands-header__action-center" style="margin-top: 14px;">
          {{ view_all_element }}
        </div>
      {% endif %}
    </div>

    {% if show_view_all and header_align != 'center' %}
      <div class="featured-brands-header__action">
        {{ view_all_element }}
      </div>
    {% endif %}
  </div>

  {% if layout_style == 'banner_slider' %}
    {%- comment -%} ================= Editorial Swiper Banner Slider ================= {%- endcomment -%}
    <div class="brand-swiper-container" id="BrandSwiperWrapper-{{ section_id }}">
      <div class="swiper brand-swiper" id="BrandSwiper-{{ section_id }}">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            {% liquid
              assign collection = block.settings.collection
              assign brand_name = block.settings.brand_name
              if brand_name == blank and collection != blank
                assign brand_name = collection.title
              endif
              if brand_name == blank
                assign brand_name = 'Brand'
              endif

              assign headline = block.settings.headline
              if headline == blank
                assign headline = brand_name | upcase
              endif

              assign link = block.settings.link
              if link == blank and collection != blank
                assign link = collection.url
              endif
              if link == blank
                assign link = '/collections/all'
              endif

              assign banner_img = block.settings.banner_image
              if banner_img == blank and collection != blank and collection.image != blank
                assign banner_img = collection.image
              elsif banner_img == blank and collection != blank and collection.featured_image != blank
                assign banner_img = collection.featured_image
              endif

              assign asset_img = block.settings.banner_image_asset
              assign logo = block.settings.logo
              assign bar_bg = block.settings.bar_color | default: '#2C1E26'
              assign bar_text = block.settings.bar_text_color | default: '#FFFFFF'
              assign btn_label = block.settings.button_label | default: 'SHOP NOW'
            %}

            <div class="swiper-slide brand-banner-slide" {{ block.shopify_attributes }}>
              <a href="{{ link }}" class="brand-banner-card">
                <div class="brand-banner-card__media brand-banner-card__media--ratio-{{ banner_ratio }}">
                  {% if banner_img != blank %}
                    {{
                      banner_img
                      | image_url: width: 1200
                      | image_tag:
                        widths: '400, 600, 800, 1200',
                        class: 'brand-banner-card__image',
                        alt: brand_name,
                        loading: 'lazy'
                    }}
                  {% elsif asset_img != blank %}
                    <img
                      src="{{ asset_img | asset_url }}"
                      alt="{{ brand_name }}"
                      class="brand-banner-card__image"
                      loading="lazy"
                      width="800"
                      height="450"
                    >
                  {% else %}
                    {{ 'collection-1' | placeholder_svg_tag: 'brand-banner-card__image brand-banner-card__image--placeholder' }}
                  {% endif %}

                  {% if logo != blank %}
                    <div class="brand-banner-card__logo-overlay">
                      {{
                        logo
                        | image_url: width: 300
                        | image_tag:
                          widths: '150, 300',
                          class: 'brand-banner-card__logo-img',
                          alt: brand_name,
                          loading: 'lazy'
                      }}
                    </div>
                  {% elsif block.settings.show_brand_name_overlay and brand_name != blank %}
                    <div class="brand-banner-card__name-overlay">
                      <span>{{ brand_name }}</span>
                    </div>
                  {% endif %}
                </div>

                <div
                  class="brand-banner-card__bar brand-banner-card__bar--{{ bar_layout }}"
                  style="
                    background-color: {{ bar_bg }};
                    color: {{ bar_text }};
                  "
                >
                  <div class="brand-banner-card__bar-content">
                    <h3 class="brand-banner-card__headline" style="color: {{ bar_text }};">
                      {{ headline }}
                    </h3>
                    {% if btn_label != blank %}
                      <span class="brand-banner-card__cta" style="color: {{ bar_text }};">
                        <span class="brand-banner-card__cta-label">{{ btn_label }}</span>
                        <svg class="brand-banner-card__cta-arrow" viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M3 8h10M9 4l4 4-4 4"/>
                        </svg>
                      </span>
                    {% endif %}
                  </div>
                </div>
              </a>
            </div>
          {% endfor %}
        </div>

        {% if show_arrows and section.blocks.size > 1 %}
          <button
            type="button"
            class="brand-swiper__nav brand-swiper__nav--prev brand-swiper__nav--{{ arrow_style }}"
            aria-label="Previous brand slide"
          >
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 18l-6-6 6-6"/>
            </svg>
          </button>
          <button
            type="button"
            class="brand-swiper__nav brand-swiper__nav--next brand-swiper__nav--{{ arrow_style }}"
            aria-label="Next brand slide"
          >
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 18l6-6-6-6"/>
            </svg>
          </button>
        {% endif %}
      </div>
    </div>

  {% else %}
    {%- comment -%} ================= Compact Logo Grid ================= {%- endcomment -%}
    <div class="brands-grid">
      {% for block in section.blocks %}
        {% liquid
          assign collection = block.settings.collection
          assign brand_name = block.settings.brand_name
          if brand_name == blank and collection != blank
            assign brand_name = collection.title
          endif
          if brand_name == blank
            assign brand_name = 'Brand Name'
          endif

          assign tagline = block.settings.headline | default: block.settings.tagline
          assign link = block.settings.link
          if link == blank and collection != blank
            assign link = collection.url
          endif
          if link == blank
            assign link = '/collections/all'
          endif

          assign logo = block.settings.logo
          if logo == blank and collection != blank and collection.image != blank
            assign logo = collection.image
          elsif logo == blank and collection != blank and collection.featured_image != blank
            assign logo = collection.featured_image
          endif
        %}

        <a href="{{ link }}" class="brand-card" {{ block.shopify_attributes }}>
          {% if logo != blank %}
            <div class="brand-card__logo-wrap">
              {{
                logo
                | image_url: width: 300
                | image_tag:
                  widths: '150, 300',
                  class: 'brand-card__logo',
                  alt: brand_name,
                  loading: 'lazy'
              }}
            </div>
          {% endif %}
          <h3 class="brand-card__name">{{ brand_name }}</h3>

          {% if tagline != blank %}
            <p class="brand-card__tagline">{{ tagline }}</p>
          {% elsif collection != blank and collection.all_products_count > 0 %}
            <p class="brand-card__tagline">{{ collection.all_products_count }} {{ collection.all_products_count | pluralize: 'product', 'products' }}</p>
          {% endif %}
        </a>
      {% endfor %}
    </div>
  {% endif %}
</div>

<style>
  /* ==========================================================================
     Featured Brands Styles (Swiper Banner Slider & Header)
     ========================================================================== */

  #FeaturedBrands-{{ section.id }} {
    position: relative;
  }

  /* Header */
  #FeaturedBrands-{{ section.id }} .featured-brands-header {
    margin-bottom: clamp(20px, 3.5vw, 36px);
  }
  #FeaturedBrands-{{ section.id }} .featured-brands-header--center {
    text-align: center;
  }
  #FeaturedBrands-{{ section.id }} .featured-brands-header--left {
    text-align: left;
  }
  #FeaturedBrands-{{ section.id }} .featured-brands-header--split {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    flex-wrap: wrap;
  }

  /* View All Button */
  #FeaturedBrands-{{ section.id }} .featured-brands__view-all-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--yozo-rosewood, #BD7385);
    text-decoration: none;
    transition: color 0.2s ease;
    white-space: nowrap;
    padding-block: 4px;
  }
  #FeaturedBrands-{{ section.id }} .featured-brands__view-all-link:hover {
    color: var(--yozo-rosewood-hover, #A75D6F);
  }
  #FeaturedBrands-{{ section.id }} .featured-brands__arrow {
    display: inline-block;
    transition: transform 0.2s ease;
  }
  #FeaturedBrands-{{ section.id }} .featured-brands__view-all-link:hover .featured-brands__arrow,
  #FeaturedBrands-{{ section.id }} .featured-brands__btn:hover .featured-brands__arrow {
    transform: translateX(4px);
  }
  #FeaturedBrands-{{ section.id }} .featured-brands__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 22px;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: all 0.25s ease;
    white-space: nowrap;
  }
  #FeaturedBrands-{{ section.id }} .featured-brands__btn--outline {
    background: transparent;
    color: var(--yozo-plum-dark, #2C1E26);
    border: 1.5px solid var(--yozo-plum-dark, #2C1E26);
  }
  #FeaturedBrands-{{ section.id }} .featured-brands__btn--outline:hover {
    background: var(--yozo-plum-dark, #2C1E26);
    color: #FFFFFF;
    transform: translateY(-2px);
  }
  #FeaturedBrands-{{ section.id }} .featured-brands__btn--rosewood {
    background: var(--yozo-rosewood, #BD7385);
    color: #FFFFFF;
    border: 1.5px solid var(--yozo-rosewood, #BD7385);
    box-shadow: 0 4px 14px rgba(189, 115, 133, 0.25);
  }
  #FeaturedBrands-{{ section.id }} .featured-brands__btn--rosewood:hover {
    background: var(--yozo-rosewood-hover, #A75D6F);
    border-color: var(--yozo-rosewood-hover, #A75D6F);
    color: #FFFFFF;
    transform: translateY(-2px);
  }

  /* ==========================================================================
     Swiper Slider & Banner Cards
     ========================================================================== */

  #FeaturedBrands-{{ section.id }} .brand-swiper-container {
    position: relative;
    width: 100%;
    overflow: visible;
  }

  #FeaturedBrands-{{ section.id }} .brand-swiper {
    position: relative;
    overflow: hidden;
    width: 100%;
    padding-bottom: 6px;
  }

  #FeaturedBrands-{{ section.id }} .brand-banner-slide {
    height: auto;
    display: flex;
  }

  #FeaturedBrands-{{ section.id }} .brand-banner-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    border-radius: var(--brand-card-radius, 12px);
    overflow: hidden;
    text-decoration: none;
    background: #FFFFFF;
    border: 1px solid var(--brand-card-border, #EFE6E8);
    box-shadow: 0 3px 14px rgba(44, 30, 38, 0.06);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.35s ease,
                border-color 0.3s ease;
  }

  #FeaturedBrands-{{ section.id }} .brand-banner-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(44, 30, 38, 0.12);
    border-color: rgba(189, 115, 133, 0.35);
  }

  /* Upper Media / Banner */
  #FeaturedBrands-{{ section.id }} .brand-banner-card__media {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: #FAF5F2;
  }

  #FeaturedBrands-{{ section.id }} .brand-banner-card__media--ratio-16_9 {
    aspect-ratio: 16 / 9;
  }
  #FeaturedBrands-{{ section.id }} .brand-banner-card__media--ratio-2_1 {
    aspect-ratio: 2 / 1;
  }
  #FeaturedBrands-{{ section.id }} .brand-banner-card__media--ratio-21_9 {
    aspect-ratio: 21 / 9;
  }
  #FeaturedBrands-{{ section.id }} .brand-banner-card__media--ratio-3_2 {
    aspect-ratio: 3 / 2;
  }

  #FeaturedBrands-{{ section.id }} .brand-banner-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
  }

  #FeaturedBrands-{{ section.id }} .brand-banner-card:hover .brand-banner-card__image {
    transform: scale(1.04);
  }

  #FeaturedBrands-{{ section.id }} .brand-banner-card__image--placeholder {
    opacity: 0.2;
    padding: 30px;
  }

  /* Brand Overlays on Banner */
  #FeaturedBrands-{{ section.id }} .brand-banner-card__logo-overlay {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 2;
    max-height: 44px;
    max-width: 120px;
  }
  #FeaturedBrands-{{ section.id }} .brand-banner-card__logo-img {
    max-height: 44px;
    max-width: 120px;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.45));
  }

  #FeaturedBrands-{{ section.id }} .brand-banner-card__name-overlay {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 2;
    font-family: var(--font-heading--family), Georgia, serif;
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #FFFFFF;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
  }

  /* Lower Solid Color Callout Bar */
  #FeaturedBrands-{{ section.id }} .brand-banner-card__bar {
    padding: {{ bar_padding_y }}px 18px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-sizing: border-box;
    min-height: {% if bar_layout == 'split' %}54px{% else %}62px{% endif %};
    transition: background-color 0.25s ease;
  }

  #FeaturedBrands-{{ section.id }} .brand-banner-card__bar--split .brand-banner-card__bar-content {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  #FeaturedBrands-{{ section.id }} .brand-banner-card__bar--stacked .brand-banner-card__bar-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
  }

  #FeaturedBrands-{{ section.id }} .brand-banner-card__headline {
    font-family: {% if headline_font == 'serif' %}var(--font-heading--family), Georgia, serif{% else %}var(--font-body--family), sans-serif{% endif %};
    font-size: clamp(0.875rem, 1.05vw, 1.025rem);
    font-weight: {% if headline_font == 'serif' %}500{% else %}700{% endif %};
    letter-spacing: {% if headline_font == 'serif' %}0.03em{% else %}0.05em{% endif %};
    text-transform: {{ headline_case }};
    line-height: 1.3;
    margin: 0;
  }

  #FeaturedBrands-{{ section.id }} .brand-banner-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-body--family), sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    opacity: 0.94;
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }

  #FeaturedBrands-{{ section.id }} .brand-banner-card__cta-label {
    position: relative;
    padding-bottom: 1px;
  }

  #FeaturedBrands-{{ section.id }} .brand-banner-card__cta-label::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0%;
    height: 1px;
    background: currentColor;
    transition: width 0.25s ease;
  }

  #FeaturedBrands-{{ section.id }} .brand-banner-card:hover .brand-banner-card__cta-label::after {
    width: 100%;
  }

  #FeaturedBrands-{{ section.id }} .brand-banner-card__cta-arrow {
    display: inline-block;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  #FeaturedBrands-{{ section.id }} .brand-banner-card:hover .brand-banner-card__cta {
    opacity: 1;
  }

  #FeaturedBrands-{{ section.id }} .brand-banner-card:hover .brand-banner-card__cta-arrow {
    transform: translateX(4px);
  }

  /* Floating Arrow Navigation */
  #FeaturedBrands-{{ section.id }} .brand-swiper__nav {
    position: absolute;
    top: 42%;
    transform: translateY(-50%);
    z-index: 10;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  #FeaturedBrands-{{ section.id }} .brand-swiper__nav--luxury_white {
    background: #FFFFFF;
    color: var(--yozo-plum-dark, #2C1E26);
    border: 1px solid var(--yozo-border, #EFE6E8);
    box-shadow: 0 4px 14px rgba(44, 30, 38, 0.12);
  }

  #FeaturedBrands-{{ section.id }} .brand-swiper__nav--luxury_white:hover {
    background: var(--yozo-rosewood, #BD7385);
    border-color: var(--yozo-rosewood, #BD7385);
    color: #FFFFFF;
    transform: translateY(-50%) scale(1.08);
    box-shadow: 0 6px 18px rgba(189, 115, 133, 0.32);
  }

  #FeaturedBrands-{{ section.id }} .brand-swiper__nav--glass_dark {
    background: rgba(44, 30, 38, 0.72);
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.35);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
  }

  #FeaturedBrands-{{ section.id }} .brand-swiper__nav--glass_dark:hover {
    background: rgba(44, 30, 38, 0.95);
    border-color: rgba(255, 255, 255, 0.7);
    transform: translateY(-50%) scale(1.08);
  }

  #FeaturedBrands-{{ section.id }} .brand-swiper__nav--rosewood {
    background: var(--yozo-rosewood, #BD7385);
    color: #FFFFFF;
    border: 1px solid var(--yozo-rosewood, #BD7385);
    box-shadow: 0 4px 14px rgba(189, 115, 133, 0.28);
  }

  #FeaturedBrands-{{ section.id }} .brand-swiper__nav--rosewood:hover {
    background: var(--yozo-rosewood-hover, #A75D6F);
    border-color: var(--yozo-rosewood-hover, #A75D6F);
    transform: translateY(-50%) scale(1.08);
    box-shadow: 0 6px 18px rgba(189, 115, 133, 0.4);
  }

  #FeaturedBrands-{{ section.id }} .brand-swiper__nav--prev {
    left: 8px;
  }

  #FeaturedBrands-{{ section.id }} .brand-swiper__nav--next {
    right: 8px;
  }

  #FeaturedBrands-{{ section.id }} .brand-swiper__nav.swiper-button-disabled {
    opacity: 0;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    #FeaturedBrands-{{ section.id }} .brand-swiper__nav {
      width: 34px;
      height: 34px;
    }
    #FeaturedBrands-{{ section.id }} .brand-swiper__nav--prev {
      left: 4px;
    }
    #FeaturedBrands-{{ section.id }} .brand-swiper__nav--next {
      right: 4px;
    }
  }

  /* Compact Grid fallback */
  #FeaturedBrands-{{ section.id }} .brand-card__logo-wrap {
    width: 100%;
    max-height: 54px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 10px;
    overflow: hidden;
  }
  #FeaturedBrands-{{ section.id }} .brand-card__logo {
    max-height: 50px;
    max-width: 120px;
    width: auto;
    height: auto;
    object-fit: contain;
  }
</style>

<script>
  (function () {
    function initBrandSwiper() {
      const container = document.getElementById('BrandSwiper-{{ section_id }}');
      if (!container) return;

      if (typeof Swiper === 'undefined') {
        setTimeout(initBrandSwiper, 60);
        return;
      }

      if (container.swiper) {
        container.swiper.destroy(true, true);
      }

      new Swiper(container, {
        slidesPerView: {{ slides_mobile }},
        spaceBetween: 14,
        grabCursor: true,
        watchSlidesProgress: true,
        {% if autoplay_enabled %}
        autoplay: {
          delay: {{ autoplay_speed | times: 1000 }},
          disableOnInteraction: false,
          pauseOnMouseEnter: true,
        },
        {% endif %}
        navigation: {
          prevEl: '#BrandSwiper-{{ section_id }} .brand-swiper__nav--prev',
          nextEl: '#BrandSwiper-{{ section_id }} .brand-swiper__nav--next',
        },
        breakpoints: {
          640: {
            slidesPerView: {{ slides_tablet }},
            spaceBetween: 18,
          },
          1024: {
            slidesPerView: {{ slides_desktop }},
            spaceBetween: {{ slide_gap }},
          }
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initBrandSwiper);
    } else {
      initBrandSwiper();
    }

    document.addEventListener('shopify:section:load', function (e) {
      if (e.target.contains(document.getElementById('FeaturedBrands-{{ section.id }}'))) {
        initBrandSwiper();
      }
    });
  })();
</script>

