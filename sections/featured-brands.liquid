{% doc %}
  Featured Brands section for Kay Cosmetics.
  Allows store owners to showcase brands they carry (such as Staplex).
  Fully merchant-configurable with brand names, logos, and collection links.
{% enddoc %}

<div
  class="section section--{{ section.settings.section_width }} featured-brands-section spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="category-grid-header">
    {% if section.settings.eyebrow != blank %}
      <span class="section-eyebrow">{{ section.settings.eyebrow }}</span>
    {% endif %}
    {% if section.settings.title != blank %}
      <h2 class="section-title">{{ section.settings.title }}</h2>
    {% endif %}
    {% if section.settings.subtitle != blank %}
      <p class="section-subtitle">{{ section.settings.subtitle }}</p>
    {% endif %}
  </div>

  <div class="brands-grid">
    {% for block in section.blocks %}
      {% liquid
        assign brand_name = block.settings.brand_name
        assign tagline = block.settings.tagline
        assign link = block.settings.link
        if link == blank
          assign link = '/collections/all'
        endif
      %}

      <a href="{{ link }}" class="brand-card" {{ block.shopify_attributes }}>
        {% if block.settings.logo != blank %}
          {{
            block.settings.logo
            | image_url: width: 300
            | image_tag:
              widths: '150, 300',
              class: 'brand-card__logo',
              alt: brand_name,
              loading: 'lazy'
          }}
        {% else %}
          <h3 class="brand-card__name">{{ brand_name }}</h3>
        {% endif %}

        {% if tagline != blank %}
          <p class="brand-card__tagline">{{ tagline }}</p>
        {% endif %}
      </a>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Featured Brands",
  "tag": "section",
  "class": "section-featured-brands",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Brand Partners"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Brands We Carry"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Explore cosmetics and beauty products available through Kay Cosmetics."
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        {
          "type": "text",
          "id": "brand_name",
          "label": "Brand Name",
          "default": "Brand Name"
        },
        {
          "type": "text",
          "id": "tagline",
          "label": "Tagline / Category (optional)"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Brand Logo (optional)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Brand Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Brands",
      "blocks": [
        {
          "type": "brand",
          "settings": {
            "brand_name": "Staplex",
            "tagline": "Cosmetics & Skincare"
          }
        }
      ]
    }
  ]
}
{% endschema %}
